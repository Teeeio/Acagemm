                    "lastServiceError": null,
                    "snapshotFingerprint": "{\"attempts\":{\"cancel\":0,\"poll\":3,\"reconcile\":0,\"submit\":1},\"cancelClaim\":null,\"completedAt\":\"2026-09-13T01:11:22.404Z\",\"deadlineAt\":\"2026-09-13T01:13:06.142Z\",\"dispatchClaim\":null,\"durationMs\":6954,\"error\":null,\"failures\":{},\"lastError\":null,\"logs\":[{\"at\":\"2026-09-13T01:11:15.450Z\",\"message\":\"Local backend execution claimed exactly once.\",\"progress\":10,\"sequence\":1},{\"at\":\"2026-09-13T01:11:21.616Z\",\"message\":\"Completed 2 benchmark profiles.\",\"progress\":90,\"sequence\":2},{\"at\":\"2026-09-13T01:11:22.473Z\",\"message\":\"Runner completed with confirmed resource release.\",\"progress\":100,\"sequence\":3}],\"payload\":{\"acceptanceDigest\":\"sha256:d36756ce0c44518f0cc14837f0b55b56b5a69cf998faef0ad2324945c661b385\",\"adapter\":{\"id\":\"python-shared-gpu\",\"languages\":[\"python\"],\"version\":\"1\"},\"admissionId\":\"sha256:25945c8a2def168cab72fb3f2d9deab11226300d39e27a64a1aeab773247f92b\",\"baselineKind\":null,\"build\":{},\"candidate\":{\"digest\":\"sha256:6cd060f7f4e8f54353d78807c80fb14fefacfa3a625112e1e95d0a8e42a1ddfc\",\"id\":\"candidate-02\",\"remoteId\":null,\"sourceRunId\":\"claude_MTZ4A4F8_4BFFB3AD\"},\"checks\":[\"correctness\",\"benchmark\"],\"deadline\":\"2026-09-13T01:13:06.129Z\",\"environmentDigest\":\"sha256:8bf3be2a795d38ced372d28982409163081bd5268bebdd4a76b21e25368666ef\",\"hardware\":[\"local-shared-gpu\"],\"limits\":{\"timeoutSeconds\":120},\"matrix\":{\"correctnessCases\":4,\"environments\":[\"local-shared-gpu\"],\"repeats\":10,\"stages\":[\"Correctness\",\"Full Benchmark\"],\"testSpec\":{\"benchmark\":{\"metrics\":[\"p50_us\",\"p95_us\",\"min_us\",\"max_us\"],\"primaryProfile\":\"primary\",\"repeats\":10,\"requiredProfiles\":[\"primary\",\"small\"],\"warmup\":3},\"correctness\":{\"atol\":0.00001,\"requestedCases\":4,\"requireNamedCases\":true,\"requiredCategories\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"rtol\":0.00001},\"generation\":{\"deterministic\":true,\"owner\":\"baseline-materializer-agent\",\"seed\":20260826,\"source\":\"authoritative-semantics\"},\"schemaVersion\":\"operator-studio.test-spec/v1\"},\"warmup\":3},\"metric\":\"latency p50\",\"missionId\":\"MIS_MTZ47TOE\",\"operator\":\"generic_affine\",\"oracleRunPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef run(inputs):\\n    # Initial implementation deliberately does one redundant device copy.\\n    value = torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n    return value.clone()\\n\",\"packageDigest\":\"sha256:ca6c5fd11d53621e71824bc2a846e678baa2816a8e984d6d228a38ba4099539f\",\"profiler\":{\"enabled\":true,\"format\":\"operator-profile/v1\"},\"purpose\":\"candidate\",\"requestId\":\"run_26D6EE63FEA618D01C03489B\",\"runPy\":\"import torch\\n\\n# ---------------------------------------------------------------------------\\n# Semantics preserved exactly from the baseline:\\n#   reference(x, y) = relu(x * 1.25 + y * 0.75 - 0.125)\\n# Only the *implementation* of run(inputs) is optimized.\\n#\\n# Optimization direction (round 2, distinct from candidate-01's in-place chain):\\n#   1. Zero-allocation fast path: every elementwise op writes into a single\\n#      preallocated output buffer via out=, so the caching allocator is never\\n#      touched on the hot path.\\n#   2. CUDA Graph replay: the 4 tiny kernels (8192 elements) are entirely\\n#      launch-bound, so the whole chain is captured once and replayed as a\\n#      single submission. Replay is guarded by an input-pointer check and the\\n#      capture is wrapped in try/except; any mismatch or failure falls back to\\n#      the correct eager path, so correctness never depends on the graph.\\n# ---------------------------------------------------------------------------\\n\\n_ALPHA = 1.25\\n_BETA = 0.75\\n_BIAS = 0.125\\n\\n_GRAPH_CACHE = {}      # shape key -> {'graph', 'out', 'xptr', 'yptr'}\\n_SHAPE_ATTEMPTS = {}   # shape key -> capture attempts (bounded churn guard)\\n_GRAPH_STATE = {'enabled': True, 'budget': 8}\\n\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\n\\ndef _eval_into(x, y, out):\\n    \\\"\\\"\\\"relu(x * 1.25 + y * 0.75 - 0.125) written into `out`. No allocations.\\\"\\\"\\\"\\n    torch.mul(x, _ALPHA, out=out)\\n    out.add_(y, alpha=_BETA)\\n    out.sub_(_BIAS)\\n    out.relu_()\\n    return out\\n\\n\\ndef _try_capture(x, y):\\n    \\\"\\\"\\\"Capture the whole chain into a CUDA graph. Returns entry or None.\\\"\\\"\\\"\\n    key = (tuple(x.shape), x.dtype)\\n    if not _GRAPH_STATE['enabled'] or _GRAPH_STATE['budget'] <= 0:\\n        return None\\n    if _SHAPE_ATTEMPTS.get(key, 0) >= 2:\\n        return None\\n    _SHAPE_ATTEMPTS[key] = _SHAPE_ATTEMPTS.get(key, 0) + 1\\n    try:\\n        out = torch.empty_like(x)\\n        side = torch.cuda.Stream()\\n        side.wait_stream(torch.cuda.current_stream())\\n        with torch.cuda.stream(side):\\n            for _ in range(2):\\n                _eval_into(x, y, out)\\n        torch.cuda.current_stream().wait_stream(side)\\n        g = torch.cuda.CUDAGraph()\\n        with torch.cuda.graph(g, stream=side):\\n            _eval_into(x, y, out)\\n        _GRAPH_STATE['budget'] -= 1\\n        return {'graph': g, 'out': out, 'xptr': x.data_ptr(), 'yptr': y.data_ptr()}\\n    except Exception:\\n        _GRAPH_STATE['enabled'] = False\\n        return None\\n\\n\\ndef run(inputs):\\n    x = inputs['x']\\n    y = inputs['y']\\n    if not (isinstance(x, torch.Tensor) and x.is_cuda):\\n        return torch.relu(x * _ALPHA + y * _BETA - _BIAS)\\n\\n    key = (tuple(x.shape), x.dtype)\\n    entry = _GRAPH_CACHE.get(key)\\n    if entry is None:\\n        entry = _try_capture(x, y)\\n        if entry is not None:\\n            _GRAPH_CACHE[key] = entry\\n    if entry is not None and entry['xptr'] == x.data_ptr() and entry['yptr'] == y.data_ptr():\\n        entry['graph'].replay()\\n        return entry['out']\\n\\n    # Correct eager fallback: still zero-allocation.\\n    return _eval_into(x, y, torch.empty_like(x))\\n\",\"runPySource\":\"run.py\",\"runtime\":\"client-managed-runtime\",\"schemaVersion\":1,\"target\":{\"device\":\"gpu\",\"platform\":\"nvidia-cuda\"},\"tracer\":{\"enabled\":true,\"format\":\"operator-trace/v1\"},\"workspaceId\":\"MIS_MTZ47TOE\"},\"progress\":100,\"q