                "snapshotFingerprint": "{\"attempts\":{\"cancel\":0,\"poll\":3,\"reconcile\":0,\"submit\":1},\"cancelClaim\":null,\"completedAt\":\"2026-09-13T01:36:01.445Z\",\"deadlineAt\":\"2026-09-13T01:37:44.672Z\",\"dispatchClaim\":null,\"durationMs\":6453,\"error\":null,\"failures\":{},\"lastError\":null,\"logs\":[{\"at\":\"2026-09-13T01:35:54.993Z\",\"message\":\"Local backend execution claimed exactly once.\",\"progress\":10,\"sequence\":1},{\"at\":\"2026-09-13T01:36:01.471Z\",\"message\":\"Runner completed with confirmed resource release.\",\"progress\":100,\"sequence\":2}],\"payload\":{\"acceptanceDigest\":\"sha256:d36756ce0c44518f0cc14837f0b55b56b5a69cf998faef0ad2324945c661b385\",\"adapter\":{\"id\":\"python-shared-gpu\",\"languages\":[\"python\"],\"version\":\"1\"},\"admissionId\":\"sha256:3b9f295bafce8db241272faba333842122183fc53a2d508b6d268d18285ddc87\",\"baselineKind\":null,\"build\":{},\"candidate\":{\"digest\":\"sha256:74c131d0fd397cd1507a7093fecb38c6b28a749d7847e39e34bc78bfa3891bb4\",\"id\":\"candidate-02\",\"remoteId\":null,\"sourceRunId\":\"claude_MTZ54ONW_E673A5E4\"},\"checks\":[\"correctness\",\"benchmark\"],\"deadline\":\"2026-09-13T01:37:44.650Z\",\"environmentDigest\":\"sha256:8bf3be2a795d38ced372d28982409163081bd5268bebdd4a76b21e25368666ef\",\"hardware\":[\"local-shared-gpu\"],\"limits\":{\"timeoutSeconds\":120},\"matrix\":{\"correctnessCases\":4,\"environments\":[\"local-shared-gpu\"],\"repeats\":10,\"stages\":[\"Correctness\",\"Full Benchmark\"],\"testSpec\":{\"benchmark\":{\"metrics\":[\"p50_us\",\"p95_us\",\"min_us\",\"max_us\"],\"primaryProfile\":\"primary\",\"repeats\":10,\"requiredProfiles\":[\"primary\",\"small\"],\"warmup\":3},\"correctness\":{\"atol\":0.00001,\"requestedCases\":4,\"requireNamedCases\":true,\"requiredCategories\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"rtol\":0.00001},\"generation\":{\"deterministic\":true,\"owner\":\"baseline-materializer-agent\",\"seed\":20260826,\"source\":\"authoritative-semantics\"},\"schemaVersion\":\"operator-studio.test-spec/v1\"},\"warmup\":3},\"metric\":\"latency p50\",\"missionId\":\"MIS_MTZ52CZJ\",\"operator\":\"generic_affine\",\"oracleRunPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef run(inputs):\\n    # Initial implementation deliberately does one redundant device copy.\\n    value = torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n    return value.clone()\\n\",\"packageDigest\":\"sha256:771086b45bd887bbb83f20e222e200ec9cdd2e9f6192ef71276f717bc5b2f015\",\"profiler\":{\"enabled\":true,\"format\":\"operator-profile/v1\"},\"purpose\":\"candidate\",\"requestId\":\"run_FA16A092FC3801E9D5E7D286\",\"runPy\":\"import torch\\n\\n# ---------------------------------------------------------------------------\\n# Optimized run(inputs) for  out = relu(x * 1.25 + y * 0.75 - 0.125)\\n#\\n# The naive_v0 baseline lowers the expression to six CUDA launches for an\\n# 8192-element tensor (mul, mul, add, sub, relu, clone).  At 32x256 the GPU\\n# work per kernel is a few microseconds at most, so the measurement is\\n# entirely launch/dispatch bound: each extra aten op costs a fixed ~2.5us.\\n# Minimizing the number of kernels is therefore the whole optimization.\\n#\\n# Algebra used to drop from six launches to three:\\n#\\n#   out = relu(1.25 * x + 0.75 * y - 0.125)\\n#       = relu(1.25 * (x + 0.6 * y) - 0.125)          since 0.75 / 1.25 == 0.6\\n#\\n#   1) acc = x + 0.6 * y            -> torch.add(x, y, alpha=0.6)\\n#      A single kernel: the y coefficient rides along as the `alpha`\\n#      argument, so the second multiply never becomes its own launch.\\n#   2) acc = 1.25 * acc - 0.125     -> torch.lerp(acc, 0.5, -0.25)\\n#      lerp(a, b, w) = a + w * (b - a) = (1 - w) * a + w * b, so with\\n#      w = -0.25 and b = 0.5 this is exactly 1.25 * a - 0.125 -- the scale\\n#      and the shift fuse into one elementwise kernel instead of two.\\n#   3) out = relu(acc)              -> torch.relu_ (in place)\\n#\\n# No step writes into the caller's tensors: (1) and (2) allocate fresh\\n# outputs and (3) only mutates the tensor produced by (2).\\n# ---------------------------------------------------------------------------\\n\\n# 0-dim lerp endpoint for step (2), materialized once per (device, dtype) so\\n# that run() never pays a host->device copy for the constant.\\n_LERP_END_CACHE = {}\\n\\n\\ndef _lerp_end(reference_tensor):\\n    key = (reference_tensor.device, reference_tensor.dtype)\\n    end = _LERP_END_CACHE.get(key)\\n    if end is None:\\n        end = torch.full((), 0.5, device=key[0], dtype=key[1])\\n        _LERP_END_CACHE[key] = end\\n    return end\\n\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\n\\ndef run(inputs):\\n    x = inputs['x']\\n    y = inputs['y']\\n    # Kernel 1: x + 0.6 * y  (0.6 == 0.75 / 1.25).\\n    acc = torch.add(x, y, alpha=0.6)\\n    # Kernel 2: 1.25 * acc - 0.125, fused into a single elementwise pass.\\n    acc = torch.lerp(acc, _lerp_end(acc), -0.25)\\n    # Kernel 3: relu, in place -> no extra allocation, no extra launch.\\n    return torch.relu_(acc)\\n\",\"runPySource\":\"run.py\",\"runtime\":\"client-managed-runtime\",\"schemaVersion\":1,\"target\":{\"device\":\"gpu\",\"platform\":\"nvidia-cuda\"},\"tracer\":{\"enabled\":true,\"format\":\"operator-trace/v1\"},\"workspaceId\":\"MIS_MTZ52CZJ\"},\"progress\":100,\"queueId\":\"queue_87D37D36E6794DA4\",\"remoteTaskId\":\"local_c500_92C3E018036E55FCC8ED0A48C2C366B8\",\"remoteTaskIds\":null,\"resourceRelease\":{\"confirmed\":true,\"deadline\":\"2026-09-13T01:37:50.112Z\",\"nextAction\":null,\"reason\":\"Runner process and owned process tree have exited.\",\"status\":\"confirmed\"},\"result\":{\"benchmark\":[{\"correctness\":{\"caseNames\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"caseResults\":[{\"case\":\"minimal\",\"cosDiff\":0,\"dtype\":\"float32\",\"maxDiff\":0,\"passed\":true,\"rmse\":0},{\"case\":\"representative\",\"cosDiff\":0,\"dtype\":\"float32\",\"maxDiff\":9.5367431640625e-7,\"passed\":true,\"rmse\":3.0781865234530414e-7},{\"case\":\"boundary\",\"cosDiff\":0,\"dtype\":\"float32\",\"maxDiff\":9.5367431640625e-7,\"passed\":true,\"rmse\":2.632069708852214e-7},{\"case\":\"ragged\",\"cosDiff\":0,\"dtype\":\"float32\",\"maxDiff\":9.5367431640625e-7,\"passed\":true,\"rmse\":2.967348677884729e-7}],\"ca