                        "snapshotFingerprint": "{\"attempts\":{\"cancel\":0,\"poll\":3,\"reconcile\":0,\"submit\":1},\"cancelClaim\":null,\"completedAt\":\"2026-09-13T02:19:59.574Z\",\"deadlineAt\":\"2026-09-13T02:21:43.227Z\",\"dispatchClaim\":null,\"durationMs\":5967,\"error\":{\"code\":\"SHARED_GPU_RUNNER_FAILED\",\"correctness\":{\"caseResults\":[],\"error\":\"Shared-GPU runner terminated without a result record.\",\"executedCases\":0,\"failure\":{\"code\":\"SHARED_GPU_RUNNER_FAILED\",\"details\":{\"exitCode\":1},\"message\":\"Shared-GPU runner terminated without a result record.\",\"phase\":\"runner\",\"retryable\":false,\"role\":\"backend\"},\"passed\":null,\"passedCases\":0,\"status\":\"not_run\",\"total\":0},\"details\":{\"exitCode\":1},\"message\":\"Shared-GPU runner terminated without a result record.\",\"phase\":\"runner\",\"retryable\":false,\"role\":\"backend\"},\"failures\":{},\"lastError\":null,\"logs\":[{\"at\":\"2026-09-13T02:19:53.608Z\",\"message\":\"Local backend execution claimed exactly once.\",\"progress\":10,\"sequence\":1},{\"at\":\"2026-09-13T02:19:59.586Z\",\"message\":\"Shared-GPU runner terminated without a result record.\",\"progress\":100,\"sequence\":2}],\"payload\":{\"acceptanceDigest\":\"sha256:d36756ce0c44518f0cc14837f0b55b56b5a69cf998faef0ad2324945c661b385\",\"adapter\":{\"id\":\"python-shared-gpu\",\"languages\":[\"python\"],\"version\":\"1\"},\"admissionId\":\"sha256:eed7300fe840742fd19d3130beb4384a2b6ae2928387474fc99623d34afcb3c8\",\"baselineKind\":null,\"build\":{},\"candidate\":{\"digest\":\"sha256:eb4c636edc2af3c9fdd73a668781cbf950f443004e0e1b061527f50a76387eff\",\"id\":\"candidate-02\",\"remoteId\":null,\"sourceRunId\":\"claude_MTZ6PUI4_0F69E495\"},\"checks\":[\"correctness\",\"benchmark\"],\"deadline\":\"2026-09-13T02:21:43.207Z\",\"environmentDigest\":\"sha256:8bf3be2a795d38ced372d28982409163081bd5268bebdd4a76b21e25368666ef\",\"hardware\":[\"local-shared-gpu\"],\"limits\":{\"timeoutSeconds\":120},\"matrix\":{\"correctnessCases\":4,\"environments\":[\"local-shared-gpu\"],\"repeats\":10,\"stages\":[\"Correctness\",\"Full Benchmark\"],\"testSpec\":{\"benchmark\":{\"metrics\":[\"p50_us\",\"p95_us\",\"min_us\",\"max_us\"],\"primaryProfile\":\"primary\",\"repeats\":10,\"requiredProfiles\":[\"primary\",\"small\"],\"warmup\":3},\"correctness\":{\"atol\":0.00001,\"requestedCases\":4,\"requireNamedCases\":true,\"requiredCategories\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"rtol\":0.00001},\"generation\":{\"deterministic\":true,\"owner\":\"baseline-materializer-agent\",\"seed\":20260826,\"source\":\"authoritative-semantics\"},\"schemaVersion\":\"operator-studio.test-spec/v1\"},\"warmup\":3},\"metric\":\"latency p50\",\"missionId\":\"MIS_MTZ6NK8A\",\"operator\":\"generic_affine\",\"oracleRunPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef run(inputs):\\n    # Initial implementation deliberately does one redundant device copy.\\n    value = torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n    return value.clone()\\n\",\"packageDigest\":\"sha256:fd2feecde39724acdd3bd6f2935adc93949b3d2b64a3fe5bc2ee630eca7cfb8e\",\"profiler\":{\"enabled\":true,\"format\":\"operator-profile/v1\"},\"purpose\":\"candidate\",\"requestId\":\"run_A9BDF18579B39EC45CB31173\",\"runPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\n# Cached 0-dim bias tensor per (device, dtype); broadcasts against any shape, so\\n# no per-shape allocation is needed and no extra kernel is launched per call.\\n_BIAS_CACHE = {}\\n\\n\\ndef _bias(like):\\n    key = (like.device, like.dtype)\\n    bias = _BIAS_CACHE.get(key)\\n    if bias is None:\\n        bias = torch.tensor(-0.1, device=like.device, dtype=like.dtype)\\n        _BIAS_CACHE[key] = bias\\n    return bias\\n\\n\\ndef run(inputs):\\n    # relu(1.25*x + 0.75*y - 0.125) == relu(1.25*(x + 0.6*y) - 0.125)\\n    # Three device kernels, three dispatches, no explicit empty_like staging:\\n    #   1) out = x + 0.6*y                 (allocates the result in one shot)\\n    #   2) out = out + 1.25*(-0.1), in place\\n    #   3) out = relu(out), in place\\n    x = inputs['x']\\n    y = inputs['y']\\n    add = torch.add\\n    out = add(x, y, alpha=0.6)\\n    add(out, _bias(x), alpha=1.25, out=out)\\n    return torch.relu_(out)\\n\",\"runPySource\":\"run.py\",\"runtime\":\"client-managed-runtime\",\"schemaVersion\":1,\"target\":{\"device\":\"gpu\",\"platform\":\"nvidia-cuda\"},\"tracer\":{\"enabled\":true,\"format\":\"operator-trace/v1\"},\"workspaceId\":\"MIS_MTZ6NK8A\"},\"progress\":100,\"queueId\":\"queue_A97389A220504865\",\"remoteTaskId\":\"local_c500_82848EB93E63C57FDD1FEBBF498CB8E4\",\"remoteTaskIds\":null,\"resourceRelease\":{\"confirmed\":true,\"deadline\":\"2026-09-13T02:21:48.459Z\",\"nextAction\":null,\"reason\":\"Runner process and owned process tree have exited.\",\"status\":\"confirmed\"},\"result\":{\"benchmark\":[],\"correctness\":{\"caseResults\":[],\"error\":\"Shared-GPU runner terminated without a result record.\",\"executedCases\":0,\"failure\":{\"code\":\"SHARED_GPU_RUNNER_FAILED\",\"details\":{\"exitCode\":1},\"message\":\"Shared-GPU runner terminated without a result record.\",\"phase\":\"runner\",\"retryable\":false,\"role\":\"backend\"},\"passed\":null,\"passedCases\":0,\"status\":\"not_run\",\"total\":0},\"environment\":{\"candidateRunPy\":\"F:\\\\设计\\\\快速项目\\\\acagemm原型\\\\.tmp-real-agent\\\\shared-gpu-iNT7Ta\\\\tasks\\\\local_c500_82848EB93E63C57FDD1FEBBF498CB8E4\\\\run.py\",\"executionMode\":\"gpu\",\"hardware\":\"nvidia-gpu\",\"liveHardware\":true,\"oracleRunPy\":\"F:\\\\设计\\\\快速项目\\\\acagemm原型\\\\.tmp-real-agent\\\\shared-gpu-iNT7Ta\\\\tasks\\\\local_c500_82848EB93E63C57FDD1FEBBF498CB8E4\\\\oracle.py\",\"publishable\":false,\"requested\":[\"local-shared-gpu\"],\"runtime\":\"local-shared-gpu-runner/v1\",\"service\":\"local-shared-gpu-adapter\",\"source\":\"local-shared-gpu\"},\"error\":{\"code\":\"SHARED_GPU_RUNNER_FAILED\",\"details\":{\"exitCode\":1},\"message\":\"Shared-GPU runner terminated without a result record.\",\"phase\":\"runner\",\"retryable\":false,\"role\":\"backend\"},\"publishable\":false,\"schemaVersion\":\"operator-studio.shared-gpu-result/v1\",\"status\":\"failed\"},\"schemaVersion\":2,\"startedAt\":\"2026-09-13T02:19:48.477Z\",\"status\":\"failed\",\"submissionStartedAt\":\"2026-09-1