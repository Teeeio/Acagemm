                    "lastServiceError": null,
                    "snapshotFingerprint": "{\"attempts\":{\"cancel\":0,\"poll\":3,\"reconcile\":0,\"submit\":1},\"cancelClaim\":null,\"completedAt\":\"2026-09-13T02:03:14.385Z\",\"deadlineAt\":\"2026-09-13T02:04:57.040Z\",\"dispatchClaim\":null,\"durationMs\":5935,\"error\":null,\"failures\":{},\"lastError\":null,\"logs\":[{\"at\":\"2026-09-13T02:03:08.450Z\",\"message\":\"Local backend execution claimed exactly once.\",\"progress\":10,\"sequence\":1},{\"at\":\"2026-09-13T02:03:14.422Z\",\"message\":\"Runner completed with confirmed resource release.\",\"progress\":100,\"sequence\":2}],\"payload\":{\"acceptanceDigest\":\"sha256:d36756ce0c44518f0cc14837f0b55b56b5a69cf998faef0ad2324945c661b385\",\"adapter\":{\"id\":\"python-shared-gpu\",\"languages\":[\"python\"],\"version\":\"1\"},\"admissionId\":\"sha256:fda2949db63dc79c7a8175db82ebb4d2c13522fda516ee575eeaafabe8231cab\",\"baselineKind\":null,\"build\":{},\"candidate\":{\"digest\":\"sha256:630407d6ed840a0e1a4928e36a6921a7d8c526ed1013b9b4b425503616c0b619\",\"id\":\"candidate-02\",\"remoteId\":null,\"sourceRunId\":\"claude_MTZ64PFZ_4054383C\"},\"checks\":[\"correctness\",\"benchmark\"],\"deadline\":\"2026-09-13T02:04:57.023Z\",\"environmentDigest\":\"sha256:8bf3be2a795d38ced372d28982409163081bd5268bebdd4a76b21e25368666ef\",\"hardware\":[\"local-shared-gpu\"],\"limits\":{\"timeoutSeconds\":120},\"matrix\":{\"correctnessCases\":4,\"environments\":[\"local-shared-gpu\"],\"repeats\":10,\"stages\":[\"Correctness\",\"Full Benchmark\"],\"testSpec\":{\"benchmark\":{\"metrics\":[\"p50_us\",\"p95_us\",\"min_us\",\"max_us\"],\"primaryProfile\":\"primary\",\"repeats\":10,\"requiredProfiles\":[\"primary\",\"small\"],\"warmup\":3},\"correctness\":{\"atol\":0.00001,\"requestedCases\":4,\"requireNamedCases\":true,\"requiredCategories\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"rtol\":0.00001},\"generation\":{\"deterministic\":true,\"owner\":\"baseline-materializer-agent\",\"seed\":20260826,\"source\":\"authoritative-semantics\"},\"schemaVersion\":\"operator-studio.test-spec/v1\"},\"warmup\":3},\"metric\":\"latency p50\",\"missionId\":\"MIS_MTZ62F7Q\",\"operator\":\"generic_affine\",\"oracleRunPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef run(inputs):\\n    # Initial implementation deliberately does one redundant device copy.\\n    value = torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n    return value.clone()\\n\",\"packageDigest\":\"sha256:125d07ffdea2834a7157f0e79fa68edc8186d4b384712a6573f785f18e3e1649\",\"profiler\":{\"enabled\":true,\"format\":\"operator-profile/v1\"},\"purpose\":\"candidate\",\"requestId\":\"run_B1F00ED4797FDC74CDFCD1BA\",\"runPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\n# Cached 0-dim constant operands (built once per device/dtype, never per call).\\n_CONST_CACHE = {}\\n\\ndef _constants(like):\\n    key = (like.device, like.dtype)\\n    consts = _CONST_CACHE.get(key)\\n    if consts is None:\\n        bias = torch.tensor(-0.125, device=like.device, dtype=like.dtype)\\n        c125 = torch.tensor(1.25, device=like.device, dtype=like.dtype)\\n        c075 = torch.tensor(0.75, device=like.device, dtype=like.dtype)\\n        consts = (bias, c125, c075)\\n        _CONST_CACHE[key] = consts\\n    return consts\\n\\ndef run(inputs):\\n    # Same math as reference(): relu(1.25*x + 0.75*y - 0.125), computed with the\\n    # minimum number of device kernels. The bias and the two scale factors are\\n    # folded into two broadcast addcmul kernels (one of them in-place on our own\\n    # output buffer), and the relu is an in-place pass, so no redundant\\n    # allocation or copy is performed and no input tensor is mutated.\\n    x = inputs['x']\\n    y = inputs['y']\\n    bias, c125, c075 = _constants(x)\\n    out = torch.addcmul(bias, x, c125)   # out = x * 1.25 - 0.125\\n    out.addcmul_(y, c075)                # out = out + y * 0.75\\n    return torch.relu_(out)              # out = max(out, 0)\\n\",\"runPySource\":\"run.py\",\"runtime\":\"client-managed-runtime\",\"schemaVersion\":1,\"target\":{\"device\":\"gpu\",\"platform\":\"nvidia-cuda\"},\"tracer\":{\"enabled\":true,\"format\":\"operator-trace/v1\"},\"workspaceId\":\"MIS_MTZ62F7Q\"},\"progress\":100,\"queueId\":\"queue_B50D60072E864D07\",\"remoteTaskId\":\"local_c500_B2F9A75FAE634F878BEF299D