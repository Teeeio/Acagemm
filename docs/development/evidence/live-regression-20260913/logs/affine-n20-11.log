                        "snapshotFingerprint": "{\"attempts\":{\"cancel\":0,\"poll\":3,\"reconcile\":0,\"submit\":1},\"cancelClaim\":null,\"completedAt\":\"2026-09-13T02:09:31.397Z\",\"deadlineAt\":\"2026-09-13T02:11:15.102Z\",\"dispatchClaim\":null,\"durationMs\":6217,\"error\":null,\"failures\":{},\"lastError\":null,\"logs\":[{\"at\":\"2026-09-13T02:09:25.180Z\",\"message\":\"Local backend execution claimed exactly once.\",\"progress\":10,\"sequence\":1},{\"at\":\"2026-09-13T02:09:30.489Z\",\"message\":\"Completed 2 benchmark profiles.\",\"progress\":90,\"sequence\":2},{\"at\":\"2026-09-13T02:09:31.491Z\",\"message\":\"Runner completed with confirmed resource release.\",\"progress\":100,\"sequence\":3}],\"payload\":{\"acceptanceDigest\":\"sha256:d36756ce0c44518f0cc14837f0b55b56b5a69cf998faef0ad2324945c661b385\",\"adapter\":{\"id\":\"python-shared-gpu\",\"languages\":[\"python\"],\"version\":\"1\"},\"admissionId\":\"sha256:3ed78eac21115aec129bbbe26ea085f13b3a304ca7787c53da9ade383b1ed9f5\",\"baselineKind\":null,\"build\":{},\"candidate\":{\"digest\":\"sha256:c971cf24d5bc29ba92d57d3e5bb661c8b3e00ec923d424b15b7d2e953d8f1678\",\"id\":\"candidate-01\",\"remoteId\":null,\"sourceRunId\":\"claude_MTZ6DDUQ_DBE8A3F5\"},\"checks\":[\"correctness\",\"benchmark\"],\"deadline\":\"2026-09-13T02:11:15.075Z\",\"environmentDigest\":\"sha256:8bf3be2a795d38ced372d28982409163081bd5268bebdd4a76b21e25368666ef\",\"hardware\":[\"local-shared-gpu\"],\"limits\":{\"timeoutSeconds\":120},\"matrix\":{\"correctnessCases\":4,\"environments\":[\"local-shared-gpu\"],\"repeats\":10,\"stages\":[\"Correctness\",\"Full Benchmark\"],\"testSpec\":{\"benchmark\":{\"metrics\":[\"p50_us\",\"p95_us\",\"min_us\",\"max_us\"],\"primaryProfile\":\"primary\",\"repeats\":10,\"requiredProfiles\":[\"primary\",\"small\"],\"warmup\":3},\"correctness\":{\"atol\":0.00001,\"requestedCases\":4,\"requireNamedCases\":true,\"requiredCategories\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"rtol\":0.00001},\"generation\":{\"deterministic\":true,\"owner\":\"baseline-materializer-agent\",\"seed\":20260826,\"source\":\"authoritative-semantics\"},\"schemaVersion\":\"operator-studio.test-spec/v1\"},\"warmup\":3},\"metric\":\"latency p50\",\"missionId\":\"MIS_MTZ6CS2C\",\"operator\":\"generic_affine\",\"oracleRunPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef run(inputs):\\n    # Initial implementation deliberately does one redundant device copy.\\n    value = torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n    return value.clone()\\n\",\"packageDigest\":\"sha256:c725fbe592a5b3c8343e2f4fe63ec067465136f8dc2e2569aa174512a2a22167\",\"profiler\":{\"enabled\":true,\"format\":\"operator-profile/v1\"},\"purpose\":\"candidate\",\"requestId\":\"run_27FDD30967D6755D457CD72E\",\"runPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef run(inputs):\\n    # Fused in-place chain: one output allocation, zero temporaries, no result copy.\\n    # Semantics are identical to reference(): relu(x * 1.25 + y * 0.75 - 0.125).\\n    x = inputs['x']\\n    y = inputs['y']\\n    out = torch.empty_like(x)\\n    torch.mul(x, 1.25, out=out)   # out = x * 1.25\\n    out.add_(y, alpha=0.75)       # out = out + 0.75 * y  (single kernel, no temp)\\n    out.sub_(0.125)               # out = out - 0.125\\n    out.relu_()                   # out = max(out, 0)\\n    return out\\n\",\"runPySource\":\"run.py\",\"runtime\":\"client-managed-runtime\",\"schemaVersion\":1,\"target\":{\"device\":\"gpu\",\"platform\":\"nvidia-cuda\"},\"tracer\":{\"enabled\":true,\"format\":\"operator-trace/v1\"},\"workspaceId\":\"MIS_MTZ6CS2C\"},\"progress\":100,\"queueId\":\"queue_68D10EABE1864C07\",\"remoteTaskId\":\"local_c500_5D69B5CC1BB4F3B96C46B6422245C935\",\"remoteTaskIds\":null,\"resourceRelease\":{\"confirmed\":true,\"deadline\":\"2026-09-13T02:11:20.576Z\",\"nextAction\":null,\"reason\":\"Runner process and owned process tree have exited.\",\"status\":\"confirmed\"},\"result\":{\"benchmark\":[{\"correctness\":{\"caseNames\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"caseResults\":[{\"case\":\"minimal\",\"cosDiff\":0,\"dtype\":\"float32\",\"maxDiff\":0,\"passed\":true,\"rmse\":0},{\"case\":\"representative\",\"cosDiff\":0,\"dtype\":\"float32\",\"maxDiff\":9.5367431640625e-7,\"passed\":true,\"rmse\":1.411929