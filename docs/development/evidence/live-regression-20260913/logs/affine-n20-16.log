                      "patch": "diff --git a/run.py b/run.py\n--- a/run.py\n+++ b/run.py\n@@ -1,5 +1,18 @@\n import torch\n \n+# Cached constant used to fold the affine scale and bias into a single kernel.\n+# The value is input independent, so it is created once per (device, dtype).\n+_CONST_CACHE = {}\n+\n+def _half_like(tensor):\n+    key = (tensor.device, tensor.dtype)\n+    half = _CONST_CACHE.get(key)\n+    if half is None:\n+        half = torch.full((), 0.5, device=tensor.device, dtype=tensor.dtype)\n+        _CONST_CACHE[key] = half\n+    return half\n+\n def inputs_for(rows, cols):\n     x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\n     return {'x': x, 'y': x.flip(-1)}\n@@ -24,4 +37,9 @@ def reference(inputs):\n     return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\n \n def run(inputs):\n-    # Initial implementation deliberately does one redundant device copy.\n-    value = torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\n-    return value.clone()\n+    # Three launches instead of six; no redundant device copy.\n+    # out = relu(1.25*x + 0.75*y - 0.125) == relu(1.25*(x + 0.6*y) - 0.125)\n+    out = torch.add(inputs['x'], inputs['y'], alpha=0.6)\n+    # lerp(out, 0.5, -0.25) == out - 0.25*(0.5 - out) == 1.25*out - 0.125\n+    out = torch.lerp(out, _half_like(out), -0.25)\n+    # clamp_min_(0) is relu, applied in place on the freshly allocated tensor.\n+    return out.clamp_min_(0.0)",
