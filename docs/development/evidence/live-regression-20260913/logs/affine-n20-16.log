                "snapshotFingerprint": "{\"attempts\":{\"cancel\":0,\"poll\":3,\"reconcile\":0,\"submit\":1},\"cancelClaim\":null,\"completedAt\":\"2026-09-13T02:48:19.717Z\",\"deadlineAt\":\"2026-09-13T02:50:03.432Z\",\"dispatchClaim\":null,\"durationMs\":6135,\"error\":null,\"failures\":{},\"lastError\":null,\"logs\":[{\"at\":\"2026-09-13T02:48:13.582Z\",\"message\":\"Local backend execution claimed exactly once.\",\"progress\":10,\"sequence\":1},{\"at\":\"2026-09-13T02:48:18.779Z\",\"message\":\"Completed 2 benchmark profiles.\",\"progress\":90,\"sequence\":2},{\"at\":\"2026-09-13T02:48:19.785Z\",\"message\":\"Runner completed with confirmed resource release.\",\"progress\":100,\"sequence\":3}],\"payload\":{\"acceptanceDigest\":\"sha256:d36756ce0c44518f0cc14837f0b55b56b5a69cf998faef0ad2324945c661b385\",\"adapter\":{\"id\":\"python-shared-gpu\",\"languages\":[\"python\"],\"version\":\"1\"},\"admissionId\":\"sha256:8c3d3559137d948103c097290db649c9be85522b36b5a0b03c83655b4a8d310d\",\"baselineKind\":null,\"build\":{},\"candidate\":{\"digest\":\"sha256:e81930a94f69bcbe718a712d2fe60919824c6a75b8ae424002ef073f05464b06\",\"id\":\"candidate-03\",\"remoteId\":null,\"sourceRunId\":\"claude_MTZ7POEA_1BDFC238\"},\"checks\":[\"correctness\",\"benchmark\"],\"deadline\":\"2026-09-13T02:50:03.413Z\",\"environmentDigest\":\"sha256:8bf3be2a795d38ced372d28982409163081bd5268bebdd4a76b21e25368666ef\",\"hardware\":[\"local-shared-gpu\"],\"limits\":{\"timeoutSeconds\":120},\"matrix\":{\"correctnessCases\":4,\"environments\":[\"local-shared-gpu\"],\"repeats\":10,\"stages\":[\"Correctness\",\"Full Benchmark\"],\"testSpec\":{\"benchmark\":{\"metrics\":[\"p50_us\",\"p95_us\",\"min_us\",\"max_us\"],\"primaryProfile\":\"primary\",\"repeats\":10,\"requiredProfiles\":[\"primary\",\"small\"],\"warmup\":3},\"correctness\":{\"atol\":0.00001,\"requestedCases\":4,\"requireNamedCases\":true,\"requiredCategories\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"rtol\":0.00001},\"generation\":{\"deterministic\":true,\"owner\":\"baseline-materializer-agent\",\"seed\":20260826,\"source\":\"authoritative-semantics\"},\"schemaVersion\":\"operator-studio.test-spec/v1\"},\"warmup\":3},\"metric\":\"latency p50\",\"missionId\":\"MIS_MTZ7LFI0\",\"operator\":\"generic_affine\",\"oracleRunPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef run(inputs):\\n    # Initial implementation deliberately does one redundant device copy.\\n    value = torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n    return value.clone()\\n\",\"packageDigest\":\"sha256:13586b0dcb8f7f91d4456f8b4fcfafe9f00b07996dd13bcf4c4093adc7b62da0\",\"profiler\":{\"enabled\":true,\"format\":\"operator-profile/v1\"},\"purpose\":\"candidate\",\"requestId\":\"run_4B53EAC41CEC6BBD48ABCC31\",\"runPy\":\"import torch\\n\\n# Cached constant used to fold the affine scale and bias into a single kernel.\\n# The value is input independent, so it is created once per (device, dtype).\\n_CONST_CACHE = {}\\n\\ndef _half_like(tensor):\\n    key = (tensor.device, tensor.dtype)\\n    half = _CONST_CACHE.get(key)\\n    if half is None:\\n        half = torch.full((), 0.5, device=tensor.device, dtype=tensor.dtype)\\n        _CONST_CACHE[key] = half\\n    return half\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef run(inputs):\\n    # Three launches instead of six; no redundant device copy.\\n    # out = relu(1.25*x + 0.75*y - 0.125) == relu(1.25*(x + 0.6*y) - 0.125)\\n    out = torch.add(inputs['x'], inputs['y'], alpha=0.6)\\n    # lerp(out, 0.5, -0.25) == out - 0.25*(0.5 - out) == 1.25*out - 0.125\\n    out = torch.lerp(out, _half_like(out), -0.25)\\n    # clamp_min_(0) is relu, applied in place on the freshly allocated tensor.\\n    return out.clamp_min_(0.0)\\n\",\"runPySource\":\"run.py\",\"runtime\":\"client-managed-runtime\",\"schemaVersion\":1,\"target\":{\"device\":\"gpu\",\"platform\":\"nvidia-cuda\"},\"tracer\":{\"enabled\":true,\"format\":\"operator-trace/v1\"},\"workspaceId\":\"MIS_MTZ7LFI0\"},\"progress\":100,\"queueId\":\"queue_70DC1B6BCA604FA5\",\"remoteTaskId\":\"local_c500_6B34CFFB8A9367FDF1D5100FA8FBDE07\",\"remoteTaskIds\":null,\"resourceRelease\":{\"confirmed\":true,\"deadline\":\"2026-09-13T02:50:08.524Z\",\"nextAction\":null,\"reason\":\"Runner process and owned process tree have exited.\",\"status\":\"confirme