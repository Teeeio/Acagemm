                    "lastServiceError": null,
                    "snapshotFingerprint": "{\"attempts\":{\"cancel\":0,\"poll\":3,\"reconcile\":0,\"submit\":1},\"cancelClaim\":null,\"completedAt\":\"2026-09-13T02:33:22.524Z\",\"deadlineAt\":\"2026-09-13T02:35:06.172Z\",\"dispatchClaim\":null,\"durationMs\":6063,\"error\":null,\"failures\":{},\"lastError\":null,\"logs\":[{\"at\":\"2026-09-13T02:33:16.461Z\",\"message\":\"Local backend execution claimed exactly once.\",\"progress\":10,\"sequence\":1},{\"at\":\"2026-09-13T02:33:21.676Z\",\"message\":\"Completed 2 benchmark profiles.\",\"progress\":90,\"sequence\":2},{\"at\":\"2026-09-13T02:33:22.573Z\",\"message\":\"Runner completed with confirmed resource release.\",\"progress\":100,\"sequence\":3}],\"payload\":{\"acceptanceDigest\":\"sha256:d36756ce0c44518f0cc14837f0b55b56b5a69cf998faef0ad2324945c661b385\",\"adapter\":{\"id\":\"python-shared-gpu\",\"languages\":[\"python\"],\"version\":\"1\"},\"admissionId\":\"sha256:e9c95d43654fcf258a6c34e9e974d7db920db299507e591a73bf4778ffbf210b\",\"baselineKind\":null,\"build\":{},\"candidate\":{\"digest\":\"sha256:c072c42d97c870d5e91a33349322e78def6b0f23bf7d4b174b4b6ae33c668c70\",\"id\":\"candidate-01\",\"remoteId\":null,\"sourceRunId\":\"claude_MTZ77MVS_178E6D3D\"},\"checks\":[\"correctness\",\"benchmark\"],\"deadline\":\"2026-09-13T02:35:06.153Z\",\"environmentDigest\":\"sha256:8bf3be2a795d38ced372d28982409163081bd5268bebdd4a76b21e25368666ef\",\"hardware\":[\"local-shared-gpu\"],\"limits\":{\"timeoutSeconds\":120},\"matrix\":{\"correctnessCases\":4,\"environments\":[\"local-shared-gpu\"],\"repeats\":10,\"stages\":[\"Correctness\",\"Full Benchmark\"],\"testSpec\":{\"benchmark\":{\"metrics\":[\"p50_us\",\"p95_us\",\"min_us\",\"max_us\"],\"primaryProfile\":\"primary\",\"repeats\":10,\"requiredProfiles\":[\"primary\",\"small\"],\"warmup\":3},\"correctness\":{\"atol\":0.00001,\"requestedCases\":4,\"requireNamedCases\":true,\"requiredCategories\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"rtol\":0.00001},\"generation\":{\"deterministic\":true,\"owner\":\"baseline-materializer-agent\",\"seed\":20260826,\"source\":\"authoritative-semantics\"},\"schemaVersion\":\"operator-studio.test-spec/v1\"},\"warmup\":3},\"metric\":\"latency p50\",\"missionId\":\"MIS_MTZ770S3\",\"operator\":\"generic_affine\",\"oracleRunPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef run(inputs):\\n    # Initial implementation deliberately does one redundant device copy.\\n    value = torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n    return value.clone()\\n\",\"packageDigest\":\"sha256:fefefdb843e2d7fc05e9277094700545cd3801c1a95b371b05d37c8f7450096a\",\"profiler\":{\"enabled\":true,\"format\":\"operator-profile/v1\"},\"purpose\":\"candidate\",\"requestId\":\"run_C1B93DCF2D7F03C50C399382\",\"runPy\":\"\\\"\\\"\\\"generic_affine -- optimized PyTorch implementation (FP32).\\n\\nSemantics preserved exactly from the mission baseline:\\n\\n    out = relu(x * 1.25 + y * 0.75 - 0.125)\\n\\nOptimization (bounded diff, implementation path only):\\n  * drop the redundant trailing ``.clone()`` device copy,\\n  * collapse the six eager kernels of\\n    ``relu(x * 1.25 + y * 0.75 - 0.125)`` (mul, mul, add, sub, relu, clone)\\n    into four in-place kernels on a single freshly allocated buffer,\\n    fusing ``+ 0.75 * y`` through the ``alpha`` argument of ``add_``,\\n  * allocate exactly one output tensor instead of six intermediates.\\n\\nAll shapes / dtypes / devices are handled generically; input tensors are\\nnever mutated (all in-place ops act on the freshly created output buffer).\\n\\\"\\\"\\\"\\n\\nimport torch\\n\\n_SCALE_X = 1.25\\n_SCALE_Y = 0.75\\n_BIAS = 0.125\\n\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\n\\ndef run(inputs):\\n    out = inputs['x'].mul(_SCALE_X)              # out = 1.25 * x\\n    out.add_(inputs['y'], alpha=_SCALE_Y)        # out = 1.25 * x + 0.75 * y\\n    out.sub_(_BIAS)                              # out = ... - 0.125\\n    out.clamp_min_(0.0)                          # relu\\n    return out\\n\",\"runPySource\":\"run.py\",\"runtime\":\"client-managed-runtime\",\"schemaVersion\":1,\"target\":{\"device\":\"gpu\",\"platform\":\"nvidia-cuda\"},\"tracer\":{\"enabled\":true,\"format\":\"operator-trace/v1\"},\"workspaceId\":\"MIS_MTZ770S3\"},\"progress\":100,\"queueId\":\"queue_CF2A70E