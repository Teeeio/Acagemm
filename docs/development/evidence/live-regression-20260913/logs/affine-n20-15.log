                        "snapshotFingerprint": "{\"attempts\":{\"cancel\":0,\"poll\":3,\"reconcile\":0,\"submit\":1},\"cancelClaim\":null,\"completedAt\":\"2026-09-13T02:35:22.281Z\",\"deadlineAt\":\"2026-09-13T02:37:06.103Z\",\"dispatchClaim\":null,\"durationMs\":5919,\"error\":{\"code\":\"SHARED_GPU_RUNNER_FAILED\",\"correctness\":{\"caseResults\":[],\"error\":\"Shared-GPU runner terminated without a result record.\",\"executedCases\":0,\"failure\":{\"code\":\"SHARED_GPU_RUNNER_FAILED\",\"details\":{\"exitCode\":1},\"message\":\"Shared-GPU runner terminated without a result record.\",\"phase\":\"runner\",\"retryable\":false,\"role\":\"backend\"},\"passed\":null,\"passedCases\":0,\"status\":\"not_run\",\"total\":0},\"details\":{\"exitCode\":1},\"message\":\"Shared-GPU runner terminated without a result record.\",\"phase\":\"runner\",\"retryable\":false,\"role\":\"backend\"},\"failures\":{},\"lastError\":null,\"logs\":[{\"at\":\"2026-09-13T02:35:16.362Z\",\"message\":\"Local backend execution claimed exactly once.\",\"progress\":10,\"sequence\":1},{\"at\":\"2026-09-13T02:35:21.574Z\",\"message\":\"Running 4 fixed correctness cases.\",\"progress\":15,\"sequence\":2},{\"at\":\"2026-09-13T02:35:22.319Z\",\"message\":\"Shared-GPU runner terminated without a result record.\",\"progress\":100,\"sequence\":3}],\"payload\":{\"acceptanceDigest\":\"sha256:d36756ce0c44518f0cc14837f0b55b56b5a69cf998faef0ad2324945c661b385\",\"adapter\":{\"id\":\"python-shared-gpu\",\"languages\":[\"python\"],\"version\":\"1\"},\"admissionId\":\"sha256:5d0f0026b4158c930960c5537b1b9bc70c0c4afba5b1ff3b0bc853006f3062e5\",\"baselineKind\":null,\"build\":{},\"candidate\":{\"digest\":\"sha256:e154bddcd7943240df18508fb3b6205819d241bb33c531165070c75f57572256\",\"id\":\"candidate-02\",\"remoteId\":null,\"sourceRunId\":\"claude_MTZ79W5K_447227F3\"},\"checks\":[\"correctness\",\"benchmark\"],\"deadline\":\"2026-09-13T02:37:06.084Z\",\"environmentDigest\":\"sha256:8bf3be2a795d38ced372d28982409163081bd5268bebdd4a76b21e25368666ef\",\"hardware\":[\"local-shared-gpu\"],\"limits\":{\"timeoutSeconds\":120},\"matrix\":{\"correctnessCases\":4,\"environments\":[\"local-shared-gpu\"],\"repeats\":10,\"stages\":[\"Correctness\",\"Full Benchmark\"],\"testSpec\":{\"benchmark\":{\"metrics\":[\"p50_us\",\"p95_us\",\"min_us\",\"max_us\"],\"primaryProfile\":\"primary\",\"repeats\":10,\"requiredProfiles\":[\"primary\",\"small\"],\"warmup\":3},\"correctness\":{\"atol\":0.00001,\"requestedCases\":4,\"requireNamedCases\":true,\"requiredCategories\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"rtol\":0.00001},\"generation\":{\"deterministic\":true,\"owner\":\"baseline-materializer-agent\",\"seed\":20260826,\"source\":\"authoritative-semantics\"},\"schemaVersion\":\"operator-studio.test-spec/v1\"},\"warmup\":3},\"metric\":\"latency p50\",\"missionId\":\"MIS_MTZ770S3\",\"operator\":\"generic_affine\",\"oracleRunPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef run(inputs):\\n    # Initial implementation deliberately does one redundant device copy.\\n    value = torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n    return value.clone()\\n\",\"packageDigest\":\"sha256:24062c6a778bcedd9c4c08f3d2b7e4b2403c6b3be3309c06bba2ab07eb57f1fd\",\"profiler\":{\"enabled\":true,\"format\":\"operator-profile/v1\"},\"purpose\":\"candidate\",\"requestId\":\"run_AAEEC355BF134FBC4E14E425\",\"runPy\":\"\\\"\\\"\\\"generic_affine (FP32) — CUDA launch-path optimization.\\n\\nFrozen semantics: out = relu(x * 1.25 + y * 0.75 - 0.125)\\n\\nRound-2 direction (different from round 1's in-place chain): fold the constant\\nterm into the y-scale kernel.  Since 0.75 * (y - 1/6) == 0.75*y - 0.125, the\\nbias -0.125 rides along inside the scaled add that computes the y contribution\\nvia `alpha`, so no separate subtract kernel is needed.  The x contribution is\\nthen applied with a scaled in-place add, and the ReLU is an in-place clamp.\\n\\nKernel count: 3 (scaled-add, scaled add_, clamp_min_) and a single output\\nallocation, versus 6 launches plus a redundant device copy in the naive_v0\\nbaseline.  No input is ever mutated, so repeated calls on the same input dict\\nstay correct.\\n\\\"\\\"\\\"\\n\\nimport torch\\n\\n# ---------------------------------------------------------------------------\\n# Input / case / benchmark factories (frozen baseline semantics, unchanged)\\n# ---------------------------------------------------------------------------\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\n# ---------------------------------------------------------------------------\\n# Optimized implementation: 3 kernels, one allocation, zero redundant copies\\n# ---------------------------------------------------------------------------\\n\\n_add = torch.add\\n\\n_X_SCALE = 1.25                  # coefficient of x\\n_Y_SCALE = 0.75                  # coefficient of y\\n_Y_SHIFT = -0.16666666666666666  # -0.125 / 0.75, folded into the y kernel\\n_ZERO = 0.0\\n\\n\\ndef run(inputs):\\n    x = inputs['x']\\n    y = inputs['y']\\n    # 0.75 * (y - 1/6) == 0.75*y - 0.125: the bias costs no extra kernel.\\n    out = _add(y, _Y_SHIFT, alpha=_Y_SCALE)\\n    # out += 1.25 * x, in place.\\n    out.add_(x, alpha=_X_SCALE)\\n    # ReLU as an in-place clamp, avoiding an extra output allocation.\\n    out.clamp_min_(_ZERO)\\n    return out\\n\",\"runPySource\":\"run.py\",\"runtime\":\"client-managed-runtime\",\"schemaVersion\":1,\"target\":{\"device\":\"gpu\",\"platform\":\"nvidia-cuda\"},\"tracer\":{\"enabled\":true,\"format\":\"operator-trace/v1\"},\"workspaceId\":\"MIS_MTZ770S3\"},\"progress\":100,\"queueId\":\"queue_D5552804F8374B3C\",\"remoteTaskId\":\"local_c500_B0BB18D6FCE341D7DBF6ADA0086D5F1C\",\"remoteTaskIds\":null,\"resourceRelease\":{\"confirmed\":true,\"deadline\":\"2026-09-13T02:37:11.553Z\",\"nextAction\":null,\"reason\":\"Runner process and owned process tree have exited.\",\"status\":\"confirmed\"},\"result\":{\"benchmark\":[],\"correctness\":{\"caseResults\":[],\"error\":\"Shared-GPU runner terminated without a result record.\",\"executedCases\":0,\"failure\":{\"code\":\"SHARED_GPU_RUNNER_FAILED\",\"details\":{\"exitCode\":1},\"message\":\"Shared-GPU runner terminated without a result record.\",\"phase\":\"runner\",\"retryable\":false,\"role\":\"backend\"},\"passed\":null,\"passedCases\":0,\"status\":\"not_run\",\"total\":0},\"environment\":{\"candidateRunPy\":\"F:\\\\设计\\\\快速项目\\\\acagemm原型\\\\.tmp-real-agent\\\\shared-gpu-soPHyY\\\\tasks\\\\local_c500_B0BB18D6FCE341D7DBF6ADA0086D5F1C\\\\run.py\",\"executionMode\":\"gpu\",\"hardware\":\"nvidia-gpu\",\"liveHardware\":true,\"oracleRunPy\":\"F:\\\\设计\\\\快速项目\\\\acagemm原型\\\\.tmp-real-agent\\\\shared-gpu-soPHyY\\\\tasks\\\\local_c500_B0BB18D6FCE341D7DBF6ADA0086D5F1C\\\\oracle.py\",\"publishable\":false,\"requested\":[\"local-shared-gpu\"],\"runtime\":\"local-shared-gpu-runner/v1\",\"service\":\"local-shared-gpu-adapter\",\"source\":\"local-shared-gpu\"},\"error\":{\"code\":\"SHARED_GPU_RUNNER_FAILED\",\"details\":{\"exitCode\":1},\"message\":\"Shared-GPU runner terminated without a result record.\",\"phase\":\"runner\",\"retryable\":false,\"role\":\"backend\"},\"publishable\":false,\"schemaVersion\":\"operator-studio.shared-gpu-result/v1\",\"status\":\"failed\"},\"schemaVersion\":2,\"startedAt\":\"2026-09-13T02:35:11.573Z\",\"status\":\"failed\",\"submissionStartedAt\":\"2026-09-13T02:35:11.505Z\",\"submittedAt\":\"2026-09-13T02:35:06.103Z\",\"taskId\":\"queue_D5552804F8374B3C\"}",
