                  "patch": "diff --git a/run.py b/run.py\n--- a/run.py\n+++ b/run.py\n@@ -22,6 +22,71 @@ def reference(inputs):\n     return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\n \n-def run(inputs):\n-    # Initial implementation deliberately does one redundant device copy.\n-    value = torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\n-    return value.clone()\n+def _affine_relu(x, y):\n+    # 1.25*x + 0.75*y - 0.125 -> relu, using in-place writes on one buffer.\n+    out = torch.mul(x, 1.25)\n+    out.add_(y, alpha=0.75)\n+    out.sub_(0.125)\n+    return out.relu_()\n+\n+\n+_GRAPH_LIMIT = 8\n+_graphs = {}\n+\n+\n+def _key(t):\n+    return (t.data_ptr(), tuple(t.shape), t.dtype, t.device.index)\n+\n+\n+def _capture(x, y):\n+    # Warm the allocation/launch path on a side stream, then capture the chain.\n+    side = torch.cuda.Stream()\n+    side.wait_stream(torch.cuda.current_stream())\n+    with torch.cuda.stream(side):\n+        for _ in range(3):\n+            _affine_relu(x, y)\n+    torch.cuda.current_stream().wait_stream(side)\n+    torch.cuda.synchronize()\n+    graph = torch.cuda.CUDAGraph()\n+    with torch.cuda.graph(graph):\n+        out = _affine_relu(x, y)\n+    graph.replay()\n+    return graph, out\n+\n+\n+def run(inputs):\n+    x, y = inputs['x'], inputs['y']\n+    cuda_ok = (\n+        x.is_cuda and y.is_cuda and x.shape == y.shape\n+        and hasattr(torch.cuda, 'CUDAGraph')\n+        and torch.cuda.is_available()\n+        and not torch.cuda.is_current_stream_capturing()\n+    )\n+    if not cuda_ok:\n+        return _affine_relu(x, y)\n+\n+    key = (_key(x), _key(y))\n+    entry = _graphs.get(key)\n+    if entry is None:\n+        if len(_graphs) < _GRAPH_LIMIT:\n+            # Hold strong refs so the captured input pointers stay live.\n+            _graphs[key] = {'x': x, 'y': y, 'graph': None, 'out': None}\n+        return _affine_relu(x, y)\n+\n+    if entry['graph'] is None:\n+        try:\n+            entry['graph'], entry['out'] = _capture(entry['x'], entry['y'])\n+        except Exception:\n+            _graphs.pop(key, None)\n+            return _affine_relu(x, y)\n+\n+    # Same input buffers seen again: replay the captured chain in one launch.\n+    entry['graph'].replay()\n+    return entry['out']\n",
                  "candidateGeneration": {
                    "schemaVersion": "operator-studio.candidate-generation/v1",
                    "format": "structured-json",
