                "snapshotFingerprint": "{\"attempts\":{\"cancel\":0,\"poll\":3,\"reconcile\":0,\"submit\":1},\"cancelClaim\":null,\"completedAt\":\"2026-09-13T02:51:41.557Z\",\"deadlineAt\":\"2026-09-13T02:53:24.876Z\",\"dispatchClaim\":null,\"durationMs\":6215,\"error\":null,\"failures\":{},\"lastError\":null,\"logs\":[{\"at\":\"2026-09-13T02:51:35.342Z\",\"message\":\"Local backend execution claimed exactly once.\",\"progress\":10,\"sequence\":1},{\"at\":\"2026-09-13T02:51:40.412Z\",\"message\":\"Running 4 fixed correctness cases.\",\"progress\":15,\"sequence\":2},{\"at\":\"2026-09-13T02:51:41.596Z\",\"message\":\"Runner completed with confirmed resource release.\",\"progress\":100,\"sequence\":3}],\"payload\":{\"acceptanceDigest\":\"sha256:d36756ce0c44518f0cc14837f0b55b56b5a69cf998faef0ad2324945c661b385\",\"adapter\":{\"id\":\"python-shared-gpu\",\"languages\":[\"python\"],\"version\":\"1\"},\"admissionId\":\"sha256:67bcf01d94f7ca56a3a53e90b1071cc092c6fcbe998515e56f0a612167cc1b1b\",\"baselineKind\":null,\"build\":{},\"candidate\":{\"digest\":\"sha256:6854c7c6ead19b1feea7d04e24da5e4aa770ede4fc4555d9324862b305ed0a2e\",\"id\":\"candidate-02\",\"remoteId\":null,\"sourceRunId\":\"claude_MTZ7V56C_B23DA72E\"},\"checks\":[\"correctness\",\"benchmark\"],\"deadline\":\"2026-09-13T02:53:24.857Z\",\"environmentDigest\":\"sha256:8bf3be2a795d38ced372d28982409163081bd5268bebdd4a76b21e25368666ef\",\"hardware\":[\"local-shared-gpu\"],\"limits\":{\"timeoutSeconds\":120},\"matrix\":{\"correctnessCases\":4,\"environments\":[\"local-shared-gpu\"],\"repeats\":10,\"stages\":[\"Correctness\",\"Full Benchmark\"],\"testSpec\":{\"benchmark\":{\"metrics\":[\"p50_us\",\"p95_us\",\"min_us\",\"max_us\"],\"primaryProfile\":\"primary\",\"repeats\":10,\"requiredProfiles\":[\"primary\",\"small\"],\"warmup\":3},\"correctness\":{\"atol\":0.00001,\"requestedCases\":4,\"requireNamedCases\":true,\"requiredCategories\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"rtol\":0.00001},\"generation\":{\"deterministic\":true,\"owner\":\"baseline-materializer-agent\",\"seed\":20260826,\"source\":\"authoritative-semantics\"},\"schemaVersion\":\"operator-studio.test-spec/v1\"},\"warmup\":3},\"metric\":\"latency p50\",\"missionId\":\"MIS_MTZ7SYVM\",\"operator\":\"generic_affine\",\"oracleRunPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef run(inputs):\\n    # Initial implementation deliberately does one redundant device copy.\\n    value = torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n    return value.clone()\\n\",\"packageDigest\":\"sha256:0ca7fd17e6c2be8419d6994628a92261c22c1171c0338ce2746d602d99fb30f1\",\"profiler\":{\"enabled\":true,\"format\":\"operator-profile/v1\"},\"purpose\":\"candidate\",\"requestId\":\"run_6B75F777C7A113FB62EA99F3\",\"runPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef _affine_relu(x, y):\\n    # 1.25*x + 0.75*y - 0.125 -> relu, using in-place writes on one buffer.\\n    out = torch.mul(x, 1.25)\\n    out.add_(y, alpha=0.75)\\n    out.sub_(0.125)\\n    return out.relu_()\\n\\n\\n_GRAPH_LIMIT = 8\\n_graphs = {}\\n\\n\\ndef _key(t):\\n    return (t.data_ptr(), tuple(t.shape), t.dtype, t.device.index)\\n\\n\\ndef _capture(x, y):\\n    # Warm the allocation/launch path on a side stream, then capture the chain.\\n    side = torch.cuda.Stream()\\n    side.wait_stream(torch.cuda.current_stream())\\n    with torch.cuda.stream(side):\\n        for _ in range(3):\\n            _affine_relu(x, y)\\n    torch.cuda.current_stream().wait_stream(side)\\n    torch.cuda.synchronize()\\n    graph = torch.cuda.CUDAGraph()\\n    with torch.cuda.graph(graph):\\n        out = _affine_relu(x, y)\\n    graph.replay()\\n    return graph, out\\n\\n\\ndef run(inputs):\\n    x, y = inputs['x'], inputs['y']\\n    cuda_ok = (\\n        x.is_cuda and y.is_cuda and x.shape == y.shape\\n        and hasattr(torch.cuda, 'CUDAGraph')\\n        and torch.cuda.is_available()\\n        and not torch.cuda.is_current_stream_capturing()\\n    )\\n    if not cuda_ok:\\n        return _affine_relu(x, y)\\n\\n    key = (_key(x), _key(y))\\n    entry = _graphs.get(key)\\n    if entry is None:\\n        if len(_graphs) < _GRAPH_LIMIT:\\n            # Hold strong refs so the captured input pointers stay live.\\n            _graphs[key] = {'x': x, 'y': y, 'graph': None, 'out': None}\\n        return _affine_relu(x, y)\\n\\n    if entry['graph'] is None:\\n        try:\\n            entry['graph'], entry['out'] = _capture(entry['x'], entry['y'])\\n        except Exception:\\n            _graphs.pop(key, None)\\n            return _affine_relu(x, y)\\n\\n    # Same input buffers seen again: replay the captured chain in one launch.\\n    entry['graph'].replay()\\n    return entry['out']\\n\",\"runPySource\":\"run.py\",\"runtime\":\"client-managed-runtime\",\"schemaVersion\":1,\"target\":{\"device\":\"gpu\",\"platform\":\"nvidia-cuda\"},\"tracer\":{\"enabled\":true,\"format\":\"operator-trace/v1\"},\"workspaceId\":\"MIS_MTZ7SYVM\"},\"progress\":100,\"queueId\":\"queue_A730AED940344267\",\"remoteTaskId\":\"local_c500_8FBDE863A5A5A1BBA2B147583128F234\",\"remoteTaskIds\":null,\"resourceRelease\":{\"confirmed\":true,\"deadline\":\"2026-09-13T02:53:30.503Z\",\"nextAction\":null,\"reason\":\"Runner process and owned process tree have exited.\",\"status\":\"confirmed\"},\"result\":{\"benchmark\":[{\"correctness\":{\"caseNames\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"caseResults\":[{\"case\":\"minimal\",\"cosDiff\":0,\"dtype\":\"float32\",\"maxDiff\":0,\"passed\":true,\"rmse\":0},{\"case\":\"representative\",\"cosDiff\":0,\"dtype\":\"float32\",\"maxDiff\":9.5367431640625e-7,\"passed\":true,\"rmse\":1.4119292757186486e-7},{\"case\":\"boundary\",\"cosDiff\":5.960464477539063e-8,\"dtype\":\"float32\",\"maxDiff\":2.384185791015625e-7,\"passed\":true,\"rmse\":2.9802322387695312e-8},{\"case\":\"ragged\",\"cosDiff\":0,\"dtype\":\"float32\",\"maxDiff\":9.5367431640625e-7,\"passed\":true,\"rmse\":1.6355380694221822e-7}],\"categories\":[\"boundary\",\"minimal\",\"ragged\",\"representative\"],\"durationMs\":337.629,\"passed\":true,\"passedCases\":4,\"referenceCache\":{\"enabled\":true,\"hits\":4,\"misses\":0,\"schemaVersion\":\"operator-studio.correctness-reference-cache/v1\"},\"total\":4},\"environment\":\"local-shared-gpu\",\"metr