                  "patch": "diff --git a/run.py b/run.py\n--- a/run.py\n+++ b/run.py\n@@ -21,7 +21,22 @@ def get_benchmark_inputs():\n def reference(inputs):\n     return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\n \n+_CONST_CACHE = {}\n+\n+def _bias_tensor(x, value):\n+    # Cached constant operand so the bias term costs no extra kernel launch.\n+    key = (tuple(x.shape), x.dtype, x.device)\n+    const = _CONST_CACHE.get(key)\n+    if const is None:\n+        const = torch.full(key[0], value, dtype=x.dtype, device=x.device)\n+        _CONST_CACHE[key] = const\n+    return const\n+\n def run(inputs):\n-    # Initial implementation deliberately does one redundant device copy.\n-    value = torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\n-    return value.clone()\n+    # 1.25*x + 0.75*y - 0.125, launched as three in-place-friendly kernels:\n+    #   bias + 1.25*x  ->  += 0.75*y  ->  clamp_min(0)\n+    x = inputs['x']\n+    y = inputs['y']\n+    out = torch.add(_bias_tensor(x, -0.125), x, alpha=1.25)\n+    out.add_(y, alpha=0.75)\n+    out.clamp_min_(0.0)\n+    return out\n",
