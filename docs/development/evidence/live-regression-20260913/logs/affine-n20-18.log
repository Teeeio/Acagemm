":{\"deterministic\":true,\"owner\":\"baseline-materializer-agent\",\"seed\":20260826,\"source\":\"authoritative-semantics\"},\"schemaVersion\":\"operator-studio.test-spec/v1\"},\"warmup\":3},\"metric\":\"latency p50\",\"missionId\":\"MIS_MTZ7X9TG\",\"operator\":\"generic_affine\",\"oracleRunPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef run(inputs):\\n    # Initial implementation deliberately does one redundant device copy.\\n    value = torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n    return value.clone()\\n\",\"packageDigest\":\"sha256:17f9527f7a1aab54087a8a25942e3c5cacb3ab26ab3989d86772ea0a6167c126\",\"profiler\":{\"enabled\":true,\"format\":\"operator-profile/v1\"},\"purpose\":\"candidate\",\"requestId\":\"run_EF1818D00D8989274701DBB8\",\"runPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\n# Cached 0-dim shift constant, keyed by (device, dtype). Building it per call\\n# would issue a host-to-device copy on the timed path.\\n_SHIFT_CACHE = {}\\n\\ndef _shift(device, dtype):\\n    key = (str(device), dtype)\\n    value = _SHIFT_CACHE.get(key)\\n    if value is None:\\n        value = torch.tensor(-0.125, dtype=dtype, device=device)\\n        _SHIFT_CACHE[key] = value\\n    return value\\n\\ndef run(inputs):\\n    # 1.25*x + 0.75*y - 0.125 == 1.25 * (x + 0.6*y - 0.1)\\n    # relu(1.25 * t) == 1.25 * relu(t) because 1.25 > 0, and\\n    # relu(z - 0.1) == clamp_min(z, 0.1) - 0.1, therefore the whole operator is\\n    #   clamp_min(x + 0.6*y, 0.1) * 1.25 - 0.125\\n    # which is three kernels: fused scale-add, clamp, fused scale-add.\\n    # The final torch.add puts the constant in the broadcast `input` slot and the\\n    # running tensor in the `other` slot so alpha=1.25 scales the tensor, giving\\n    # the 1.25*t - 0.125 step in a single kernel instead of mul_ + sub_.\\n    # The clamp is applied in place on the freshly allocated add() result, so the\\n    # caller's inputs are never mutated and no clone of the result is needed.\\n    value = torch.add(inputs['x'], inputs['y'], alpha=0.6)\\n    torch.clamp_min_(value, 0.1)\\n    return torch.add(_shift(value.device, value.dtype), value, alpha=1.25)\\n\",\"runPySource\":\"run.py\",\"runtime\":\"client-managed-runtime\",\"schemaVersion\":1,\"target\":{\"device\":\"gpu\",\"platform\":\"nvidia-cuda\"},\"t