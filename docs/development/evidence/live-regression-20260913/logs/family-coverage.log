                "snapshotFingerprint": "{\"attempts\":{\"cancel\":0,\"poll\":3,\"reconcile\":0,\"submit\":1},\"cancelClaim\":null,\"completedAt\":\"2026-09-13T01:19:52.547Z\",\"deadlineAt\":\"2026-09-13T01:21:36.728Z\",\"dispatchClaim\":null,\"durationMs\":6131,\"error\":null,\"failures\":{},\"lastError\":null,\"logs\":[{\"at\":\"2026-09-13T01:19:46.416Z\",\"message\":\"Local backend execution claimed exactly once.\",\"progress\":10,\"sequence\":1},{\"at\":\"2026-09-13T01:19:51.540Z\",\"message\":\"Running 4 fixed correctness cases.\",\"progress\":15,\"sequence\":2},{\"at\":\"2026-09-13T01:19:52.605Z\",\"message\":\"Runner completed with confirmed resource release.\",\"progress\":100,\"sequence\":3}],\"payload\":{\"acceptanceDigest\":\"sha256:92505fc69626996c693eff581f06c3c6044ffaceb321a5eec5d55c9f53837d7b\",\"adapter\":{\"id\":\"python-shared-gpu\",\"languages\":[\"python\"],\"version\":\"1\"},\"admissionId\":\"sha256:617c00d3f7e160d254bab34d0ac62a5a52875acefda988ae868e4bf332e341e5\",\"baselineKind\":null,\"build\":{},\"candidate\":{\"digest\":\"sha256:4281b6127f1f8bb8858fa4cb7d198c9334b17cdf0b2f56c0d6f36c1fe3981097\",\"id\":\"candidate-02\",\"remoteId\":null,\"sourceRunId\":\"claude_MTZ4K3RB_624CAD2C\"},\"checks\":[\"correctness\",\"benchmark\"],\"deadline\":\"2026-09-13T01:21:36.713Z\",\"environmentDigest\":\"sha256:8bf3be2a795d38ced372d28982409163081bd5268bebdd4a76b21e25368666ef\",\"hardware\":[\"local-shared-gpu\"],\"limits\":{\"timeoutSeconds\":120},\"matrix\":{\"correctnessCases\":4,\"environments\":[\"local-shared-gpu\"],\"repeats\":10,\"stages\":[\"Correctness\",\"Full Benchmark\"],\"testSpec\":{\"benchmark\":{\"metrics\":[\"p50_us\",\"p95_us\",\"min_us\",\"max_us\"],\"primaryProfile\":\"primary\",\"repeats\":10,\"requiredProfiles\":[\"primary\",\"small\"],\"warmup\":3},\"correctness\":{\"atol\":0.00001,\"requestedCases\":4,\"requireNamedCases\":true,\"requiredCategories\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"rtol\":0.00001},\"generation\":{\"deterministic\":true,\"owner\":\"baseline-materializer-agent\",\"seed\":20260826,\"source\":\"authoritative-semantics\"},\"schemaVersion\":\"operator-studio.test-spec/v1\"},\"warmup\":3},\"metric\":\"latency p50\",\"missionId\":\"MIS_MTZ4HQFV\",\"operator\":\"generic_normalization\",\"oracleRunPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return inputs['x'] * torch.rsqrt((inputs['x'] * inputs['x']).mean(dim=-1, keepdim=True) + 1e-5)\\n\\ndef run(inputs):\\n    # Initial implementation deliberately does one redundant device copy.\\n    value = inputs['x'] * torch.rsqrt((inputs['x'] * inputs['x']).mean(dim=-1, keepdim=True) + 1e-5)\\n    return value.clone()\\n\",\"packageDigest\":\"sha256:7e1f0f7418f352a9d460a8a79ca026ae328d2532a0936371fbf3706dd44dfb07\",\"profiler\":{\"enabled\":true,\"format\":\"operator-profile/v1\"},\"purpose\":\"candidate\",\"requestId\":\"run_774E2BC97F26FD2A87A49CA0\",\"runPy\":\"import torch\\n\\n_EPS = 1e-5\\n_EPS_BUFFERS = {}\\n\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\n\\ndef reference(inputs):\\n    return inputs['x'] * torch.rsqrt((inputs['x'] * inputs['x']).mean(dim=-1, keepdim=True) + 1e-5)\\n\\n\\ndef _eps_buffer(shape, device, dtype):\\n    # Constant eps tile, allocated once per (shape, device, dtype) and read-only afterwards.\\n    key = (tuple(shape), device, dtype)\\n    buf = _EPS_BUFFERS.get(key)\\n    if buf is None:\\n        buf = torch.full(key[0], _EPS, device=device, dtype=dtype)\\n        _EPS_BUFFERS[key] = buf\\n    return buf\\n\\n\\ndef run(inputs):\\n    x = inputs['x']\\n    # The row-wise L2 norm reduces sum(x*x) inside a single reduction kernel, so the\\n    # full-size x*x tensor that the baseline materializes is never allocated or written.\\n    norm = torch.linalg.vector_norm(x, dim=-1, keepdim=True)\\n    # mean(x*x) + eps == eps + norm*norm/cols. Folding the 1/cols scale and the eps\\n    # offset into one addcmul keeps the whole per-row transform at two tiny kernels.\\n    mean_eps = torch.addcmul(_eps_buffer(norm.shape, norm.device, norm.dtype), norm, norm,\\n                             value=1.0 / x.shape[-1])\\n    return x * mean_eps.rsqrt_()\\n\",\"runPySource\":\"run.py\",\"runtime\":\"client-managed-runtime\",\"schemaVersion\":1,\"target\":{\"device\":\"gpu\",\"platform\":\"nvidia-cuda\"},\"tracer\":{\"enabled\":true,\"format\":\"operator-trace/v1\"},\"workspaceId\":\"MIS_MTZ4HQFV\"},\"progress\":100,\"queueId\":\"queue_BFD73364C8934181\",\"remoteTaskId\":\"local_c500_9C8