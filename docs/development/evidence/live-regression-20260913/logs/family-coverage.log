                    "snapshotFingerprint": "{\"attempts\":{\"cancel\":0,\"poll\":3,\"reconcile\":0,\"submit\":1},\"cancelClaim\":null,\"completedAt\":\"2026-09-13T01:15:48.922Z\",\"deadlineAt\":\"2026-09-13T01:17:31.033Z\",\"dispatchClaim\":null,\"durationMs\":6550,\"error\":null,\"failures\":{},\"lastError\":null,\"logs\":[{\"at\":\"2026-09-13T01:15:42.372Z\",\"message\":\"Local backend execution claimed exactly once.\",\"progress\":10,\"sequence\":1},{\"at\":\"2026-09-13T01:15:48.959Z\",\"message\":\"Runner completed with confirmed resource release.\",\"progress\":100,\"sequence\":2}],\"payload\":{\"acceptanceDigest\":\"sha256:aa6335100915aed7e9f8bd7b1b55268363b9c0499d2de5d5e55259c09fea5534\",\"adapter\":{\"id\":\"python-shared-gpu\",\"languages\":[\"python\"],\"version\":\"1\"},\"admissionId\":\"sha256:b69389317a817186c1c455f682feee7ba37f96a3277b3b1609723e4a49f55d72\",\"baselineKind\":null,\"build\":{},\"candidate\":{\"digest\":\"sha256:6d11d157a1e3c195f07fc9c9d36434e043dcda8aa0e51326d780fe727fd0c47f\",\"id\":\"candidate-02\",\"remoteId\":null,\"sourceRunId\":\"claude_MTZ4FPMP_447201F3\"},\"checks\":[\"correctness\",\"benchmark\"],\"deadline\":\"2026-09-13T01:17:31.006Z\",\"environmentDigest\":\"sha256:8bf3be2a795d38ced372d28982409163081bd5268bebdd4a76b21e25368666ef\",\"hardware\":[\"local-shared-gpu\"],\"limits\":{\"timeoutSeconds\":120},\"matrix\":{\"correctnessCases\":4,\"environments\":[\"local-shared-gpu\"],\"repeats\":10,\"stages\":[\"Correctness\",\"Full Benchmark\"],\"testSpec\":{\"benchmark\":{\"metrics\":[\"p50_us\",\"p95_us\",\"min_us\",\"max_us\"],\"primaryProfile\":\"primary\",\"repeats\":10,\"requiredProfiles\":[\"primary\",\"small\"],\"warmup\":3},\"correctness\":{\"atol\":0.00001,\"requestedCases\":4,\"requireNamedCases\":true,\"requiredCategories\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"rtol\":0.00001},\"generation\":{\"deterministic\":true,\"owner\":\"baseline-materializer-agent\",\"seed\":20260826,\"source\":\"authoritative-semantics\"},\"schemaVersion\":\"operator-studio.test-spec/v1\"},\"warmup\":3},\"metric\":\"latency p50\",\"missionId\":\"MIS_MTZ4DFHG\",\"operator\":\"generic_reduction\",\"oracleRunPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return (inputs['x'] * inputs['y']).sum(dim=-1)\\n\\ndef run(inputs):\\n    # Initial implementation deliberately does one redundant device copy.\\n    value = (inputs['x'] * inputs['y']).sum(dim=-1)\\n    return value.clone()\\n\",\"packageDigest\":\"sha256:ef1071500018937c6efade6b0974c7fa171603785ab2c82b1fb6cedc3fe53603\",\"profiler\":{\"enabled\":true,\"format\":\"operator-profile/v1\"},\"purpose\":\"candidate\",\"requestId\":\"run_6AA3F182A8C88896056CCFB4\",\"runPy\":\"import torch\\n\\n# The fused path below runs through cuBLAS. On sm86 cuBLAS may select TF32\\n# tensor-core kernels for fp32 GEMM when that global flag is enabled, which\\n# would reduce mantissa precision relative to the fp32 accumulate used by the\\n# reference reduction. Force IEEE fp32 so the fused kernel matches the oracle\\n# numerics regardless of ambient backend state.\\ntry:\\n    torch.backends.cuda.matmul.allow_tf32 = False\\nexcept Exception:\\n    pass\\n\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\n\\ndef reference(inputs):\\n    return (inputs['x'] * inputs['y']).sum(dim=-1)\\n\\n\\ndef run(inputs):\\n    # Row-wise sum of products expressed as one batched matrix product:\\n    #   (rows, 1, cols) @ (rows, cols, 1) -> (rows, 1, 1)\\n    # The elementwise multiply and the last-dim reduction are fused into a\\n    # single cuBLAS kernel launch, replacing the two-kernel mul+sum sequence\\n    # (each kernel launch costs several microseconds on this runner, so\\n    # launch count dominates at 32x256). Both unsqueezes and the final\\n    # view(-1) are metadata-only reshapes: no extra device work.\\n    return torch.bmm(inputs['x'].unsqueeze(1), inputs['y'].unsqueeze(2)).view(-1)\\n\",\"runPySource\":\"run.py\",\"runtime\":\"client-managed-runtime\",\"schemaVersion\":1,\"target\":{\"device\":\"gpu\",\"platform\":\"nvidia-cuda\"},\"tracer\":{\"enabled\":true,\"format\":\"operator-trace/v1\"},\"workspaceId\":\"MIS_MTZ4DFHG\"},\"progress\":100,\"queueId\":\"queue_BF9413D8CFE14FB5\",\"remoteTaskId\":\"local_c500_ED88F5C874B3FA5ED1867C40B08D1F42\",\"remoteTaskIds\":null,\"resourceRelease\":{\"confirmed\":true,\"deadline\":\"2026-09-13T01:17:36.354Z\",\"nextAction\":null,\"reason\":\"Runner process and owned process tree have exited.\",\"status\":\"co