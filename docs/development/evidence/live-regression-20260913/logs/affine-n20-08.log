generation\":{\"deterministic\":true,\"owner\":\"baseline-materializer-agent\",\"seed\":20260826,\"source\":\"authoritative-semantics\"},\"schemaVersion\":\"operator-studio.test-spec/v1\"},\"warmup\":3},\"metric\":\"latency p50\",\"missionId\":\"MIS_MTZ5UO8M\",\"operator\":\"generic_affine\",\"oracleRunPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef run(inputs):\\n    # Initial implementation deliberately does one redundant device copy.\\n    value = torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n    return value.clone()\\n\",\"packageDigest\":\"sha256:eea85346e2bfd9e8fd244235b4342ddf4a764449dd2a5bcd8927c0ae05817217\",\"profiler\":{\"enabled\":true,\"format\":\"operator-profile/v1\"},\"purpose\":\"candidate\",\"requestId\":\"run_7BF926CEBBB7B5BE07C6D929\",\"runPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef run(inputs):\\n    # Single output buffer, written through in place: the redundant device copy\\n    # (clone) and the per-op temporaries of the eager expression are removed,\\n    # so the chain issues 4 fused-friendly kernels instead of 5 plus allocations.\\n    x = inputs['x']\\n    y = inputs['y']\\n    out = torch.empty_like(x)\\n    torch.mul(x, 1.25, out=out)\\n    out.add_(y, alpha=0.75)\\n    out.sub_(0.125)\\n    return torch.relu_(out)\\n\",\"runPySource\":\"run.py\",\"runtime\":\"client-managed-runtime\",\"schemaVersion\":1,\"target\":{\"device\":\"gpu\",\"platform\":\"nvidia-cuda\"},\"tracer\":{\"enabled\":true,\"format\":\"operator-trace/v1\"},\"workspaceId\":\"MIS_MTZ5UO8M\"},\"progress\":100,\"queueId\":\"queue_3A3678770BB343A7\",\"remoteTaskId\":\"local_c500_B2693A6ECBF483173FBA646BDEA9D8D3\",\"remoteTaskIds\":null,\"resourceRelease\":{\"confirmed\":true,\"deadline\":\"2026-09-13T01:57:51.132Z\",\"nextAction\":null,\"reason\":\"Runner process and owned process tree have exited.\",\"status\":\"confirmed\"},\"result\":{\"benchmark\":[{\"correctness\":{\"caseNames\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"caseResults\":[{\"case\":\"minimal\",\"cosDiff\":0,\"dtype\":\"float32\",\"maxDiff\":0,\"passed\":true,\"rmse\":0},{\"case\":\"representative\",\"cosDiff\":0,\"dtype\":\"float32\",\"maxDiff\":9.5367431640625e-7,\"passed\":true,\"rmse\":1.4119292757186486e-7},{\"case\":\"boundary\",\"cosDiff\":5.960464477539063e-8,\