                  "patch": "diff --git a/run.py b/run.py\n--- a/run.py\n+++ b/run.py\n@@ -21,7 +21,14 @@\n def reference(inputs):\n     return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\n \n def run(inputs):\n-    # Initial implementation deliberately does one redundant device copy.\n-    value = torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\n-    return value.clone()\n+    # Single fresh buffer, in-place chain, no clone and no host-side capture.\n+    #   t = 1.25*x  ->  t += 0.75*y  ->  t -= 0.125  ->  t = relu(t)\n+    # 4 elementwise kernels instead of the baseline's mul/mul/add/sub/relu + copy.\n+    # Purely eager: no CUDA graph capture, no stream surgery, no cached output\n+    # buffers, so repeated calls with different shapes stay safe.\n+    t = torch.mul(inputs['x'], 1.25)\n+    t.add_(inputs['y'], alpha=0.75)\n+    t.sub_(0.125)\n+    t.relu_()\n+    return t\n",
