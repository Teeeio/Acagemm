                        "snapshotFingerprint": "{\"attempts\":{\"cancel\":0,\"poll\":3,\"reconcile\":0,\"submit\":1},\"cancelClaim\":null,\"completedAt\":\"2026-09-13T01:58:06.635Z\",\"deadlineAt\":\"2026-09-13T01:59:50.715Z\",\"dispatchClaim\":null,\"durationMs\":5690,\"error\":{\"code\":\"SHARED_GPU_RUNNER_FAILED\",\"correctness\":{\"caseResults\":[],\"error\":\"Shared-GPU runner terminated without a result record.\",\"executedCases\":0,\"failure\":{\"code\":\"SHARED_GPU_RUNNER_FAILED\",\"details\":{\"exitCode\":1},\"message\":\"Shared-GPU runner terminated without a result record.\",\"phase\":\"runner\",\"retryable\":false,\"role\":\"backend\"},\"passed\":null,\"passedCases\":0,\"status\":\"not_run\",\"total\":0},\"details\":{\"exitCode\":1},\"message\":\"Shared-GPU runner terminated without a result record.\",\"phase\":\"runner\",\"retryable\":false,\"role\":\"backend\"},\"failures\":{},\"lastError\":null,\"logs\":[{\"at\":\"2026-09-13T01:58:00.945Z\",\"message\":\"Local backend execution claimed exactly once.\",\"progress\":10,\"sequence\":1},{\"at\":\"2026-09-13T01:58:06.096Z\",\"message\":\"Correctness failed: minimal.\",\"progress\":100,\"sequence\":2},{\"at\":\"2026-09-13T01:58:06.658Z\",\"message\":\"Shared-GPU runner terminated without a result record.\",\"progress\":100,\"sequence\":3}],\"payload\":{\"acceptanceDigest\":\"sha256:d36756ce0c44518f0cc14837f0b55b56b5a69cf998faef0ad2324945c661b385\",\"adapter\":{\"id\":\"python-shared-gpu\",\"languages\":[\"python\"],\"version\":\"1\"},\"admissionId\":\"sha256:3b886c6ec1773882b54e904b91420479b1db77155820b64428c17d0b81c239b3\",\"baselineKind\":null,\"build\":{},\"candidate\":{\"digest\":\"sha256:b88f6bc7e0a017c8710608fd33f557d1636273adcf41b19a166963e201df44f6\",\"id\":\"candidate-02\",\"remoteId\":null,\"sourceRunId\":\"claude_MTZ5XTG5_8C3C20DB\"},\"checks\":[\"correctness\",\"benchmark\"],\"deadline\":\"2026-09-13T01:59:50.696Z\",\"environmentDigest\":\"sha256:8bf3be2a795d38ced372d28982409163081bd5268bebdd4a76b21e25368666ef\",\"hardware\":[\"local-shared-gpu\"],\"limits\":{\"timeoutSeconds\":120},\"matrix\":{\"correctnessCases\":4,\"environments\":[\"local-shared-gpu\"],\"repeats\":10,\"stages\":[\"Correctness\",\"Full Benchmark\"],\"testSpec\":{\"benchmark\":{\"metrics\":[\"p50_us\",\"p95_us\",\"min_us\",\"max_us\"],\"primaryProfile\":\"primary\",\"repeats\":10,\"requiredProfiles\":[\"primary\",\"small\"],\"warmup\":3},\"correctness\":{\"atol\":0.00001,\"requestedCases\":4,\"requireNamedCases\":true,\"requiredCategories\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"rtol\":0.00001},\"generation\":{\"deterministic\":true,\"owner\":\"baseline-materializer-agent\",\"seed\":20260826,\"source\":\"authoritative-semantics\"},\"schemaVersion\":\"operator-studio.test-spec/v1\"},\"warmup\":3},\"metric\":\"latency p50\",\"missionId\":\"MIS_MTZ5UO8M\",\"operator\":\"generic_affine\",\"oracleRunPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef run(inputs):\\n    # Initial implementation deliberately does one redundant device copy.\\n    value = torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n    return value.clone()\\n\",\"packageDigest\":\"sha256:8c9f9cd81de52ce34c1f1bea1c4565dc53dad86e488438e8fed05f1e2d9d4686\",\"profiler\":{\"enabled\":true,\"format\":\"operator-profile/v1\"},\"purpose\":\"candidate\",\"requestId\":\"run_268C5A7205A9396FFC5D5DBC\",\"runPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\n\\n# ---------------------------------------------------------------------------\\n# Optimized implementation path for run(inputs).\\n#\\n# The op is a tiny elementwise chain (8192 fp32 elements), so the latency is\\n# almost entirely kernel-launch / host-dispatch bound, not bandwidth bound.\\n# Two bounded levers are applied:\\n#   1) Fuse the graph into 3 in-place kernels on a caller-owned buffer\\n#      (no per-call allocation, no copy). relu(z - 0.125) is exactly\\n#      threshold(z, 0.125, 0) because 0.125 is a power of two, so the\\n#      subtract+relu pair collapses into a single kernel.\\n#   2) When the very same input buffers are presented repeatedly (the steady\\n#      state of a benchmark loop), capture those 3 kernels once into a CUDA\\n#      graph and replay the whole chain with a single host call.\\n#\\n# Both levers are pure-PyTorch and side-effect free with respect to the\\n# inputs: x and y are only ever read, and every call returns a tensor that\\n# the implementation owns.\\n# ---------------------------------------------------------------------------\\n\\n_GRAPH_CACHE = {}\\n_SEEN = {}\\n_FAILED = set()\\n_MAX_GRAPHS = 32\\n\\n\\ndef _key(x, y):\\n    # Buffer identity (address + shape + stride + dtype + device) is what a\\n    # replayed CUDA graph actually reads from, so it is the only thing that\\n    # makes a captured graph valid to reuse.\\n    return (\\n        x.shape, x.stride(), x.dtype, x.device, x.data_ptr(),\\n        y.shape, y.stride(), y.dtype, y.device, y.data_ptr(),\\n    )\\n\\n\\ndef _launch(x, y, out):\\n    # out = relu(x * 1.25 + y * 0.75 - 0.125), three kernels, zero allocation.\\n    torch.mul(x, 1.25, out=out)\\n    out.add_(y, alpha=0.75)\\n    torch.threshold(out, 0.125, 0.0, out=out)\\n    return out\\n\\n\\ndef _eager(x, y):\\n    return _launch(x, y, torch.empty_like(x))\\n\\n\\ndef run(inputs):\\n    x = inputs['x']\\n    y = inputs['y']\\n\\n    if not (x.is_cuda and y.is_cuda and x.is_contiguous() and y.is_contiguous()):\\n        return _eager(x, y)\\n\\n    key = _key(x, y)\\n\\n    entry = _GRAPH_CACHE.get(key)\\n    if entry is not None:\\n        graph, out = entry\\n        graph.replay()\\n        return out\\n\\n    out = _eager(x, y)\\n\\n    # Only capture once the identical buffer set has been observed twice: a\\n    # one-shot call (e.g. a correctness case) must never pay capture cost, and\\n    # a caller that hands us fresh buffers every call never captures at all.\\n    if key in _FAILED:\\n        return out\\n    seen = _SEEN.get(key, 0)\\n    if seen == 0:\\n        if len(_SEEN) < 4096:\\n            _SEEN[key] = 1\\n        return out\\n\\n    if len(_GRAPH_CACHE) >= _MAX_GRAPHS:\\n        return out\\n\\n    try:\\n        side = torch.cuda.Stream()\\n        side.wait_stream(torch.cuda.current_stream())\\n        with torch.cuda.stream(side):\\n            _launch(x, y, out)\\n        torch.cuda.current_stream().wait_stream(side)\\n\\n        graph = torch.cuda.CUDAGraph()\\n        with torch.cuda.graph(graph):\\n            _launch(x, y, out)\\n        _GRAPH_CACHE[key] = (graph, out)\\n        _SEEN.pop(key, None)\\n    except Exception:\\n        # Capture is a pure optimization: on any failure keep the eager path.\\n        _FAILED.add(key)\\n        _GRAPH_CACHE.pop(key, None)\\n\\n    return out\\n\",\"runPySource\":\"run.py\",\"runtime\":\"client-managed-runtime\",\"schemaVersion\":1,\"target\":{\"device\":\"gpu\",\"platform\":\"nvidia-cuda\"},\"tracer\":{\"enabled\":true,\"format\":\"operator-trace/v1\"},\"workspaceId\":\"MIS_MTZ5UO8M\"},\"progress\":100,\"queueId\":\"queue_8D305E7D9CDB4178\",\"remoteTaskId\":\"local_c500_9E107F6327FE7BEA995BA897BF2F5F8F\",\"remoteTaskIds\":null,\"resourceRelease\":{\"confirmed\":true,\"deadline\":\"2026-09-13T01:59:56.054Z\",\"nextAction\":null,\"reason\":\"Runner process and owned process tree have exited.\",\"status\":\"confirmed\"},\"result\":{\"benchmark\":[],\"correctness\":{\"caseResults\":[],\"error\":\"Shared-GPU runner terminated without a result record.\",\"executedCases\":0,\"failure\":{\"code\":\"SHARED_GPU_RUNNER_FAILED\",\"details\":{\"exitCode\":1},\"message\":\"Shared-GPU runner terminated without a result record.\",\"phase\":\"runner\",\"retryable\":false,\"role\":\"backend\"},\"passed\":null,\"passedCases\":0,\"status\":\"not_run\",\"total\":0},\"environment\":{\"candidateRunPy\":\"F:\\\\设计\\\\快速项目\\\\acagemm原型\\\\.tmp-real-agent\\\\shared-gpu-X69hIj\\\\tasks\\\\local_c500_9E107F6327FE7BEA995BA897BF2F5F8F\\\\run.py\",\"executionMode\":\"gpu\",\"hardware\":\"nvidia-gpu\",\"liveHardware\":true,\"oracleRunPy\":\"F:\\\\设计\\\\快速项目\\\\acagemm原型\\\\.tmp-real-agent\\\\shared-gpu-X69hIj\\\\tasks\\\\local_c500_9E107F6327FE7BEA995BA897BF2F5F8F\\\\oracle.py\",\"publishable\":false,\"requested\":[\"local-shared-gpu\"],\"runtime\":\"local-shared-gpu-runne