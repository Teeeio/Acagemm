                    "lastServiceError": null,
                    "snapshotFingerprint": "{\"attempts\":{\"cancel\":0,\"poll\":3,\"reconcile\":0,\"submit\":1},\"cancelClaim\":null,\"completedAt\":\"2026-09-13T02:16:07.881Z\",\"deadlineAt\":\"2026-09-13T02:17:51.740Z\",\"dispatchClaim\":null,\"durationMs\":6059,\"error\":null,\"failures\":{},\"lastError\":null,\"logs\":[{\"at\":\"2026-09-13T02:16:01.822Z\",\"message\":\"Local backend execution claimed exactly once.\",\"progress\":10,\"sequence\":1},{\"at\":\"2026-09-13T02:16:06.639Z\",\"message\":\"Running 4 fixed correctness cases.\",\"progress\":15,\"sequence\":2},{\"at\":\"2026-09-13T02:16:08.004Z\",\"message\":\"Runner completed with confirmed resource release.\",\"progress\":100,\"sequence\":3}],\"payload\":{\"acceptanceDigest\":\"sha256:d36756ce0c44518f0cc14837f0b55b56b5a69cf998faef0ad2324945c661b385\",\"adapter\":{\"id\":\"python-shared-gpu\",\"languages\":[\"python\"],\"version\":\"1\"},\"admissionId\":\"sha256:a1eb3f98bcb25ae6c261fdf4f239c55b81f897f5b2150ce1fd5bb120bed16c7c\",\"baselineKind\":null,\"build\":{},\"candidate\":{\"digest\":\"sha256:244fde82943de9e83df6eea2a0fa0cb48480fc7fc178b5bffa76ee1b40801d23\",\"id\":\"candidate-02\",\"remoteId\":null,\"sourceRunId\":\"claude_MTZ6KT02_EC097219\"},\"checks\":[\"correctness\",\"benchmark\"],\"deadline\":\"2026-09-13T02:17:51.720Z\",\"environmentDigest\":\"sha256:8bf3be2a795d38ced372d28982409163081bd5268bebdd4a76b21e25368666ef\",\"hardware\":[\"local-shared-gpu\"],\"limits\":{\"timeoutSeconds\":120},\"matrix\":{\"correctnessCases\":4,\"environments\":[\"local-shared-gpu\"],\"repeats\":10,\"stages\":[\"Correctness\",\"Full Benchmark\"],\"testSpec\":{\"benchmark\":{\"metrics\":[\"p50_us\",\"p95_us\",\"min_us\",\"max_us\"],\"primaryProfile\":\"primary\",\"repeats\":10,\"requiredProfiles\":[\"primary\",\"small\"],\"warmup\":3},\"correctness\":{\"atol\":0.00001,\"requestedCases\":4,\"requireNamedCases\":true,\"requiredCategories\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"rtol\":0.00001},\"generation\":{\"deterministic\":true,\"owner\":\"baseline-materializer-agent\",\"seed\":20260826,\"source\":\"authoritative-semantics\"},\"schemaVersion\":\"operator-studio.test-spec/v1\"},\"warmup\":3},\"metric\":\"latency p50\",\"missionId\":\"MIS_MTZ6HYBV\",\"operator\":\"generic_affine\",\"oracleRunPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef run(inputs):\\n    # Initial implementation deliberately does one redundant device copy.\\n    value = torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n    return value.clone()\\n\",\"packageDigest\":\"sha256:8e2d168d922cea7386873db15316e0eb8666cbb494de1998d701b6e2027ad977\",\"profiler\":{\"enabled\":true,\"format\":\"operator-profile/v1\"},\"purpose\":\"candidate\",\"requestId\":\"run_98E1A3271D82602FB36BD0AC\",\"runPy\":\"import torch\\n\\ndef inputs_for(rows, cols):\\n    x = (torch.linspace(-2, 2, rows * cols, device='cuda', dtype=torch.float32) + 3).reshape(rows, cols)\\n    return {'x': x, 'y': x.flip(-1)}\\n\\ndef get_inputs():\\n    return inputs_for(32, 256)\\n\\ndef get_test_cases():\\n    return [\\n        {'name': 'minimal', 'category': 'minimal', 'inputs': inputs_for(1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\n# ---------------------------------------------------------------------------\\n# Optimized implementation.\\n#\\n# The operator is relu(x * 1.25 + y * 0.75 - 0.125) on a 32x256 FP32 tensor.\\n# For 8192 elements the GPU work is negligible: p50 is dominated by per-call\\n# CPU dispatch + kernel-launch cost.  The previous round reduced the chain to\\n# four in-place kernels (mul/add_/sub_/relu_) and measured 11.264us, i.e. still\\n# roughly launch bound.  This round attacks the launches themselves: the same\\n# in-place chain is captured once into a CUDA graph for a given input signature\\n# and afterwards replayed with a single graph launch.\\n#\\n# Safety properties:\\n#   * Only the implementation path of run() changes; get_inputs /\\n#     get_test_cases / get_benchmark_inputs / reference are untouched.\\n#   * Inputs are never mutated (the in-place ops act on a freshly allocated\\n#     output buffer that this module owns).\\n#   * Replay re-reads x and y at their captured addresses, so it stays correct\\n#     even when the caller mutates the input contents between calls.  The cache\\n#     holds references to x and y, so those addresses cannot be recycled by a\\n#     different tensor, and the cache key pins pointer/shape/stride/dtype/device.\\n#   * Capture only happens on the second call with an identical signature, so a\\n#     caller that hands us fresh tensors every call never triggers a capture.\\n#   * Everything is wrapped: any capture failure falls back to plain eager\\n#     execution of the same math.\\n# ---------------------------------------------------------------------------\\n_ALPHA_X = 1.25\\n_ALPHA_Y = 0.75\\n_BIAS = 0.125\\n\\n_GRAPH_LIMIT = 8\\n_SEEN_LIMIT = 64\\n_seen = {}\\n_graphs = {}\\n\\n\\ndef _eager(x, y):\\n    out = torch.mul(x, _ALPHA_X)\\n    out.add_(y, alpha=_ALPHA_Y)\\n    out.sub_(_BIAS)\\n    return torch.relu_(out)\\n\\n\\ndef _signature(x, y):\\n    return (\\n        x.data_ptr(), y.data_ptr(),\\n        tuple(x.shape), tuple(y.shape),\\n        tuple(x.stride()), tuple(y.stride()),\\n        x.dtype, y.dtype, x.device, y.device,\\n    )\\n\\n\\ndef _fast_path_supported(x, y):\\n    if not (x.is_cuda and y.is_cuda):\\n        return False\\n    if not hasattr(torch.cuda, 'CUDAGraph'):\\n        return False\\n    if x.dtype != torch.float32 or y.dtype != torch.float32:\\n        return False\\n    if x.shape != y.shape:\\n        return False\\n    if not (x.is_contiguous() and y.is_contiguous()):\\n        return False\\n    return True\\n\\n\\ndef _capture(x, y):\\n    out = torch.empty_like(x)\\n    side = torch.cuda.Stream()\\n    side.wait_stream(torch.cuda.current_stream())\\n    with torch.cuda.stream(side):\\n        for _ in range(3):\\n            torch.mul(x, _ALPHA_X, out=out)\\n            out.add_(y, alpha=_ALPHA_Y)\\n            out.sub_(_BIAS)\\n            torch.relu_(out)\\n    torch.cuda.current_stream().wait_stream(side)\\n    graph = torch.cuda.CUDAGraph()\\n    with torch.cuda.graph(graph):\\n        torch.mul(x, _ALPHA_X, out=out)\\n        out.add_(y, alpha=_ALPHA_Y)\\n        out.sub_(_BIAS)\\n        torch.relu_(out)\\n    return graph, out\\n\\n\\ndef run(inputs):\\n    x = inputs['x']\\n    y = inputs['y']\\n    if not _fast_path_supported(x, y):\\n        return _eager(x, y)\\n\\n    key = _signature(x, y)\\n    entry = _graphs.get(key)\\n    if entry is None:\\n        first_sighting = _seen.get(key, 0) == 0\\n        if len(_seen) < _SEEN_LIMIT:\\n            _seen[key] = _seen.get(key, 0) + 1\\n        if not first_sighting and len(_graphs) < _GRAPH_LIMIT:\\n            try:\\n                graph, out = _capture(x, y)\\n                entry = (graph, out, x, y)\\n                _graphs[key] = entry\\n            except Exception:\\n                entry = None\\n        if entry is None:\\n            return _eager(x, y)\\n\\n    graph, out, _x, _y = entry\\n    graph.replay()\\n    return out\\n\",\"runPySource\":\"run.py\",\"runtime\":\"client-managed-runtime\",\"schemaVersion\":1,\"target\":{\"device\":\"gpu\",\"platform\":\"nvidia-cuda\"},\"tracer\":{\"enabled\":true,\"format\":\"operator-trace/v1\"},\"workspaceId\":\"MIS_MTZ6HYBV\"},\"progress\":100,\"queueId\":\"queue_AE1FAF6FA76C47B1\",\"remoteTaskId\":\"local_c500_221699128CC5408CDFC020A7719074E0\",\"remoteTaskIds\":null,\"resourceRelease\":{\"confirmed\":true,\"deadline\":\"2026-09-13T02:17:56.659Z\",\"nextAction\":null,\"reason\":\"Runner process and owned process tree have exited.\",\"status\":\"confirmed\"},\"result\":{\"benchmark\":[{\"correctness\":{\"caseNames\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"caseResults\":[{\"case\":\"minimal\",\"cosDiff\":0,\"dtype\":\"float32\",\"maxDiff\":0,\"passed\":true,\"rmse\":0},{\"case\":\"representative\",\"cosDiff\":0,\"dtype\":\"float32\",\"maxDiff\":9.5367431640625e-7,\"passed\":true,\"rmse\":1.4119292757186486e-7},{\"case\":\"boundary\",\"cosDiff\":5.960464477539063e-8,\"dtype\":\"float32\",\"maxDiff\":2.384185791015625e-7,\"passed\":true,\"rmse\":2.9802322387695312e-8},{\"case\":\"ragged\",\"cosDiff\":0,\"dtype\":\"float32\",\"maxDiff\":9.5367431640625e-7,\"passed\":true,\"rmse\":1.6355380694221822e-7}],\"categories\":[\"boundary\",\"minimal\",\"ragged\",\"representative\"],\"durationMs\":330.624,\"passed\":true,\"passedCases\":4,\"referenceCache\":{\"enabled\":true,\"hits\":4,\"misses\":0,\"schemaVersion\":\"operator-studio.correctness-reference-cache/v1\"},\"total\":4}