1, 1)},\\n        {'name': 'representative', 'category': 'representative', 'inputs': get_inputs()},\\n        {'name': 'boundary', 'category': 'boundary', 'inputs': inputs_for(2, 32)},\\n        {'name': 'ragged', 'category': 'ragged', 'inputs': inputs_for(3, 17)},\\n    ]\\n\\ndef get_benchmark_inputs():\\n    return [{'name': 'primary', 'inputs': get_inputs()}, {'name': 'small', 'inputs': inputs_for(2, 32)}]\\n\\ndef reference(inputs):\\n    return torch.relu(inputs['x'] * 1.25 + inputs['y'] * 0.75 - 0.125)\\n\\ndef run(inputs):\\n    # Single output allocation, then pure in-place elementwise kernels: removes the\\n    # redundant device copy and all intermediate temporaries of the baseline.\\n    x = inputs['x']\\n    y = inputs['y']\\n    out = torch.empty_like(x)\\n    torch.mul(x, 1.25, out=out)\\n    torch.add(out, y, alpha=0.75, out=out)\\n    torch.sub(out, 0.125, out=out)\\n    out.relu_()\\n    return out\\n\",\"runPySource\":\"run.py\",\"runtime\":\"client-managed-runtime\",\"schemaVersion\":1,\"target\":{\"device\":\"gpu\",\"platform\":\"nvidia-cuda\"},\"tracer\":{\"enabled\":true,\"format\":\"operator-trace/v1\"},\"workspaceId\":\"MIS_MTZ5IUYQ\"},\"progress\":100,\"queueId\":\"queue_4FE42CBE6BF74D95\",\"remoteTaskId\":\"local_c500_94AC54F5FE4B8341DD53F59636A6D598\",\"remoteTaskIds\":null,\"resourceRelease\":{\"confirmed\":true,\"deadline\":\"2026-09-13T01:47:59.458Z\",\"nextAction\":null,\"reason\":\"Runner process and owned process tree have exited.\",\"status\":\"confirmed\"},\"result\":{\"benchmark\":[{\"correctness\":{\"caseNames\":[\"minimal\",\"representative\",\"boundary\",\"ragged\"],\"caseResults\":[{\"case\":\"minimal\",\"cosDiff\":0,\"dtype\":\"float32\",\"maxDiff\":0,\"passed\":true,\"rmse\":0},{\"case\":\"representative\",\"cosDiff\":0,\"dtype\":\"float32\",\"maxDiff\":9.5367431640625e-7,\"passed\":true,\"rmse\":1.4119292757186486e-7},{\"case\":\"boundary\",\"cosDiff\":5.960464477539063e-8,\"dtype\":\"float32\",\"maxDiff\":2.38418579101562